---
// Inlines one of Sova's line icons (src/icons/, copied from the app's public/icons) so it takes
// currentColor and follows the theme.
const icons = import.meta.glob<string>("../icons/*.svg", { query: "?raw", import: "default", eager: true });

interface Props { name: string; size?: number; class?: string }
const { name, size = 16, class: cls = "" } = Astro.props;
const raw = icons[`../icons/${name}.svg`];
if (!raw) throw new Error(`No icon named ${name}`);
const svg = raw.replace(/<svg[^>]*>/, (tag) =>
  tag
    .replace(/\s(width|height|role|aria-label|class)="[^"]*"/g, "")
    .replace("<svg", `<svg width="${size}" height="${size}" class="icon ${cls}" aria-hidden="true" focusable="false"`),
);
---
<Fragment set:html={svg} />
