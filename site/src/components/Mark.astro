---
// The Sova mark, inline so it takes currentColor (the accent, where it's used). The legs shade in
// alpha toward the folds; ids are per instance, since a page inlines the mark more than once.
// `tile` draws the app icon instead (public/favicon.svg): the dusk tile, a white middle band and
// legs shading #ECEAFF→#ADA7F5, fixed colours in both themes.
interface Props { size?: number; tile?: boolean; class?: string }
const { size = 22, tile = false, class: cls = "" } = Astro.props;
const id = `sova-fold-${Math.random().toString(36).slice(2, 8)}`;
const [hi, lo] = tile ? ["#ECEAFF", "#ADA7F5"] : ["currentColor", "currentColor"];
const [hiA, loA] = tile ? ["1", "1"] : [".85", ".5"];
---
<svg class={`mark${tile ? " mark-tile" : ""} ${cls}`} viewBox="0 0 32 32" width={size} height={size} aria-hidden="true" focusable="false">
  <defs>
    {tile && <linearGradient id={`${id}-t`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#4A43D8" /><stop offset="1" stop-color="#1E1A5C" /></linearGradient>}
    <linearGradient id={`${id}-l`} gradientUnits="userSpaceOnUse" x1="0" y1="6" x2="0" y2="26"><stop offset="0" stop-color={hi} stop-opacity={hiA} /><stop offset="1" stop-color={lo} stop-opacity={loA} /></linearGradient>
    <linearGradient id={`${id}-r`} gradientUnits="userSpaceOnUse" x1="0" y1="6" x2="0" y2="26"><stop offset="0" stop-color={lo} stop-opacity={loA} /><stop offset="1" stop-color={hi} stop-opacity={hiA} /></linearGradient>
  </defs>
  {tile && <rect width="32" height="32" rx="8" fill={`url(#${id}-t)`} />}
  <g transform="translate(0.5 0)">
    <polygon fill={`url(#${id}-l)`} points="2,6 8,6 15,26 9,26" />
    <polygon fill={`url(#${id}-r)`} points="16,6 22,6 29,26 23,26" />
    <polygon fill={tile ? "#FFFFFF" : "currentColor"} points="9,26 15,26 22,6 16,6" />
  </g>
</svg>
