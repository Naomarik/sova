{
  "$schema": "pi-web-theme/v1",
  "name": "Monokai Pro",
  "extends": "dark",
  "vars": {
    "background": "#2d2a2e",
    "text": "#fcfcfa",
    "accent3": "#ffd866",
    "accent4": "#a9dc76",
    "accent5": "#78dce8",
    "accent6": "#ab9df2",
    "dimmed1": "#c1c0c0",
    "dimmed4": "#5b595c"
  },
  "colors": {
    "bg": "$background",
    "surface": "#3c3a3d",
    "sunken": "#353236",
    "ink": "$text",
    "ink-2": "$dimmed1",
    "ink-muted": "#a5a4a5",
    "border": "$dimmed4",
    "border-strong": "#868486",
    "accent": "$accent6",
    "accent-hover": "#cac1f7",
    "accent-tint": "#39306b",
    "on-accent": "$background",
    "status-success": "$accent4",
    "status-warn": "$accent3",
    "status-error": "#ff809f",
    "status-info": "$accent5",
    "status-success-bg": "#314221",
    "status-warn-bg": "#493b15",
    "status-error-bg": "#6e2033",
    "status-info-bg": "#1f4246",
    "diff-add-bg": "#314221",
    "diff-add-ink": "$accent4",
    "diff-del-bg": "#6e2033",
    "diff-del-ink": "#ff809f",
    "diff-gutter": "#353236",
    "shadow-1": "0 1px 2px rgba(0, 0, 0, .5)",
    "shadow-2": "0 1px 2px rgba(0, 0, 0, .5), 0 8px 24px -12px rgba(0, 0, 0, .75)",
    "shadow-3": "0 2px 4px rgba(0, 0, 0, .6), 0 18px 44px -16px rgba(0, 0, 0, .85)",
    "scrim": "rgba(14, 14, 19, .62)",
    "skeleton-sweep": "rgba(255, 255, 255, .07)"
  }
}
