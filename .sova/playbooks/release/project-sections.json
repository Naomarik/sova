{
  "deploy": {
    "targets": {
      "site": {
        "about": "Sova's landing page and docs, served by Cloudflare Pages.",
        "branch": "master",
        "releases": "only",
        "requires": {
          "tests": "none"
        },
        "credentials": [
          {
            "name": "cloudflare",
            "kind": "tool-login",
            "check": [
              "wrangler",
              "whoami"
            ]
          },
          {
            "name": "SOVA_SITE_PAGES_PROJECT",
            "kind": "env",
            "check": [
              "node",
              ".sova/playbooks/release/scripts/sova-release.mjs",
              "env-set",
              "SOVA_SITE_PAGES_PROJECT"
            ]
          }
        ],
        "build": [
          {
            "id": "video",
            "run": [
              "node",
              ".sova/playbooks/release/scripts/sova-release.mjs",
              "site-video",
              "${checkout}"
            ]
          },
          {
            "id": "install",
            "run": [
              "pnpm",
              "--dir",
              "site",
              "install",
              "--frozen-lockfile"
            ]
          },
          {
            "id": "site",
            "run": [
              "env",
              "SOVA_SITE_URL=https://sova.naomarik.com/",
              "pnpm",
              "--dir",
              "site",
              "run",
              "build"
            ],
            "timeout": 900
          }
        ],
        "steps": [
          {
            "id": "pages",
            "run": [
              "node",
              ".sova/playbooks/release/scripts/sova-release.mjs",
              "site-pages",
              "${commit}"
            ]
          }
        ],
        "verify": {
          "http": "https://sova.naomarik.com/"
        },
        "rollback": "redeploy-previous"
      }
    }
  },
  "release": {
    "playbook": ".sova/playbooks/release",
    "tag": "v${version}",
    "scheme": "semver",
    "channels": [
      "stable"
    ],
    "commit": true,
    "checks": [
      {
        "id": "release-notes",
        "label": "Release notes entry",
        "run": [
          "node",
          ".sova/playbooks/release/scripts/sova-release.mjs",
          "changelog-check"
        ],
        "timeout": 60
      },
      {
        "id": "release-integration",
        "label": "Every integration group",
        "run": [
          "node",
          "scripts/nice.mjs",
          "node",
          "scripts/run-tests.mjs",
          "--integration"
        ],
        "timeout": 1800,
        "rerun": true
      },
      {
        "id": "release-extensions",
        "label": "Every extension suite",
        "run": [
          "node",
          ".sova/playbooks/release/scripts/sova-release.mjs",
          "ext-all"
        ],
        "timeout": 1800
      },
      {
        "id": "release-spec-replay",
        "label": "Spec replay",
        "run": [
          "node",
          "scripts/merge-checks/spec-replay.mjs",
          "--picked"
        ],
        "timeout": 1800
      },
      {
        "id": "release-site",
        "label": "Site build",
        "run": [
          "node",
          ".sova/playbooks/release/scripts/sova-release.mjs",
          "site-check"
        ],
        "timeout": 900
      },
      {
        "id": "release-spec",
        "label": "No new spec findings",
        "run": [
          "node",
          ".sova/playbooks/release/scripts/sova-release.mjs",
          "spec-new"
        ],
        "timeout": 600
      },
      {
        "id": "release-leaks",
        "label": "Leak scan since the last release",
        "run": [
          "node",
          ".sova/playbooks/release/scripts/sova-release.mjs",
          "leak-scan"
        ],
        "timeout": 600
      }
    ]
  }
}
