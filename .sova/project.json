{
  "version": 1,
  "slots": {"cap": 15},
  "sources": ["package.json", "mise.toml", "pnpm-lock.yaml", "scripts/hermetic-agent-dir.mjs"],
  "setup": [
    {
      "id": "mise-trust",
      "run": ["mise", "trust"],
      "inputs": ["mise.toml"]
    },
    {
      "id": "node-modules",
      "run": ["node", "scripts/copy-node-modules.mjs", "${main}/node_modules", "node_modules"],
      "inputs": [
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "package.json",
        "scripts/copy-tree.mjs",
        "scripts/copy-node-modules.mjs"
      ],
      "timeout": 600
    },
    {
      "id": "agent-dir",
      "run": ["node", "scripts/hermetic-agent-dir.mjs"],
      "inputs": ["scripts/hermetic-agent-dir.mjs", "pi-config/settings.json"]
    }
  ],
  "services": {
    "server": {
      "cmd": ["pnpm", "run", "dev:hermetic"],
      "env": {"SOVA_PORT": "${ports.server.http}"},
      "ports": {
        "http": {"base": 4810, "stride": 10}
      },
      "ready": {"http": "http", "path": "/api/health", "timeout": 120},
      "about": "This copy's Sova on http://127.0.0.1:${ports.server.http}/ with its own .agent (sessions, state, settings); GET /api/health gives startedAt and head.",
      "isolation": {
        "method": "ports",
        "why": "Each slot's server runs on its own port with the checkout's own .agent dir; slot 0 is the live sova-runtime.service, which Sova only reads."
      },
      "adopt": {
        "unit": "sova-runtime.service",
        "ports": {"http": 4800}
      }
    }
  },
  "test": {
    "run": ["node", "scripts/run-tests.mjs"],
    "smoke": ["shared/project-contract.test.ts"]
  },
  "share": {"allow": false},
  "deploy": {
    "targets": {
      "site": {
        "about": "Sova's landing page and docs, served by Cloudflare Pages.",
        "branch": "master",
        "releases": "only",
        "requires": {"tests": "none"},
        "credentials": [
          {
            "name": "cloudflare",
            "kind": "tool-login",
            "check": ["wrangler", "whoami"]
          },
          {
            "name": "SOVA_SITE_PAGES_PROJECT",
            "kind": "env",
            "check": [
              "node",
              ".sova/playbook-config/release/scripts/sova-release.mjs",
              "env-set",
              "SOVA_SITE_PAGES_PROJECT"
            ]
          },
          {
            "name": "SOVA_SITE_VIDEO_DIR",
            "kind": "env",
            "check": [
              "node",
              ".sova/playbook-config/release/scripts/sova-release.mjs",
              "env-set",
              "SOVA_SITE_VIDEO_DIR"
            ]
          }
        ],
        "build": [
          {
            "id": "video",
            "run": [
              "node",
              ".sova/playbook-config/release/scripts/sova-release.mjs",
              "site-video",
              "${checkout}"
            ]
          },
          {
            "id": "install",
            "run": ["pnpm", "--dir", "site", "install", "--frozen-lockfile"]
          },
          {
            "id": "site",
            "run": [
              "env",
              "SOVA_SITE_URL=https://sova.naomarik.com/",
              "pnpm",
              "--dir",
              "site",
              "run",
              "build"
            ],
            "timeout": 900
          }
        ],
        "steps": [
          {
            "id": "pages",
            "run": [
              "node",
              ".sova/playbook-config/release/scripts/sova-release.mjs",
              "site-pages",
              "${commit}"
            ]
          }
        ],
        "verify": {"http": "https://sova.naomarik.com/"},
        "rollback": "redeploy-previous"
      }
    }
  },
  "merge": {
    "target": "master",
    "push": true,
    "checks": [
      {
        "id": "typecheck",
        "label": "Typecheck",
        "run": ["pnpm", "run", "typecheck"],
        "timeout": 600
      },
      {
        "id": "unit",
        "label": "Unit tests",
        "run": ["node", "scripts/nice.mjs", "node", "scripts/run-tests.mjs"],
        "timeout": 1500,
        "rerun": true
      },
      {
        "id": "integration",
        "label": "Integration",
        "run": [
          "node",
          "scripts/nice.mjs",
          "node",
          "scripts/run-tests.mjs",
          "--integration",
          "--landing",
          "--base",
          "${merge.base}"
        ],
        "timeout": 1800,
        "rerun": true
      },
      {
        "id": "extensions",
        "label": "Changed extensions",
        "run": ["node", "scripts/merge-checks/ext-suites.mjs"],
        "timeout": 900
      },
      {
        "id": "playbook-tests",
        "label": "Playbook tests",
        "run": ["node", "scripts/merge-checks/playbook-tests.mjs"],
        "timeout": 600
      },
      {
        "id": "spec-replay",
        "label": "Spec replay",
        "run": ["node", "scripts/merge-checks/spec-replay.mjs"],
        "timeout": 1800
      },
      {
        "id": "statecharts",
        "label": "Statecharts",
        "run": ["node", "scripts/merge-checks/statecharts.mjs"],
        "timeout": 1200
      },
      {
        "id": "build",
        "label": "Build",
        "run": ["pnpm", "run", "build"],
        "timeout": 900
      },
      {
        "id": "spec",
        "label": "Spec check",
        "run": ["node", "scripts/merge-checks/spec.mjs"],
        "timeout": 300
      },
      {
        "id": "leak-scan",
        "label": "Leak scan",
        "run": ["node", "scripts/merge-checks/leak-scan.mjs"],
        "timeout": 300
      },
      {
        "id": "e2e",
        "label": "Walkthroughs",
        "run": ["node", "scripts/merge-checks/e2e.mjs"],
        "timeout": 1800,
        "rerun": true,
        "optional": true
      },
      {
        "id": "integration-group",
        "label": "Slow test group",
        "run": [
          "node",
          "scripts/nice.mjs",
          "node",
          "scripts/run-tests.mjs",
          "--integration",
          "--picked-groups"
        ],
        "timeout": 1800,
        "rerun": true,
        "optional": true,
        "perSelector": true
      }
    ],
    "install": {
      "run": ["pnpm", "install", "--frozen-lockfile", "--offline"],
      "inputs": ["pnpm-lock.yaml", "pnpm-workspace.yaml", "package.json"],
      "timeout": 600
    },
    "rules": [
      {
        "paths": ["statecharts/**", "scripts/statecharts*.mjs", "scripts/statecharts.ts", "scripts/build-statecharts.mjs"],
        "check": "statecharts",
        "why": "statecharts changed: compile them and run their tests"
      },
      {
        "paths": ["pi-config/extensions/spec/core/**", "pi-config/extensions/spec/tests/replay/**", "pi-config/extensions/spec/WRITING.md", "pi-config/extensions/spec/PROMOTE.md", "pi-config/extensions/mode/spec-mode.md"],
        "check": "spec-replay",
        "why": "the spec engine or its procedure changed: replay recorded spec sessions"
      },
      {
        "paths": ["src/components/Composer*.tsx", "src/components/WorktreesControl.tsx", "src/components/WorktreesModal.tsx", "src/lib/composer*.ts", "src/lib/focus-view*.ts"],
        "check": "e2e",
        "select": ["scripts/e2e/focus-view.mjs", "scripts/e2e/instant-open.mjs"],
        "why": "the composer changed: drive its browser walkthroughs"
      },
      {
        "paths": ["src/lib/type-anywhere*.ts", "src/commands/keys*.ts", "src/components/Composer*.tsx", "src/components/SessionPane.tsx", "scripts/e2e/type-anywhere.mjs"],
        "check": "e2e",
        "select": ["scripts/e2e/type-anywhere.mjs"],
        "why": "the app-wide keys, the composer or Session details changed: drive Type anywhere in a browser"
      },
      {
        "paths": ["src/components/Transcript*.tsx", "src/lib/transcript*.ts", "src/lib/follow*.ts"],
        "check": "e2e",
        "select": ["scripts/e2e/transcript-follow.mjs", "scripts/e2e/transcript-drift.mjs", "scripts/e2e/jump-settle.mjs"],
        "why": "the transcript view changed: drive its scrolling walkthroughs"
      },
      {
        "paths": ["src/components/Overseer*.tsx", "src/components/Schedule*.tsx", "src/lib/schedules*.ts"],
        "check": "e2e",
        "select": ["scripts/e2e/overseer-schedules-menu.mjs"],
        "why": "the Overseer's schedules menu changed: drive its walkthrough"
      },
      {
        "paths": ["src/vis/kinds/flow/**"],
        "check": "e2e",
        "select": ["scripts/e2e/flow-focus.mjs"],
        "why": "the flow view changed: drive its focus walkthrough"
      },
      {
        "paths": ["server/tours/**", "shared/tour*", "server/tour-routes.ts", "server/project-services/tour-target*", "server/share/tour-*", "pi-config/extensions/sandbox/**"],
        "check": "integration-group",
        "select": ["tours"],
        "why": "tours code changed: run the Tours group (a landing never runs it on its own)"
      },
      {
        "paths": ["server/chat-runtime/**", "server/chat-host*", "server/chat-handle*", "server/chat-manager*", "server/harness/**"],
        "check": "integration-group",
        "select": ["trial"],
        "why": "chat processes changed: run the Chat processes group (its trigger already does; listed so the reason shows)"
      },
      {
        "paths": ["server/merge-queue/**", "scripts/merge-checks/**", ".sova/project.json"],
        "check": "integration-group",
        "select": ["merge-queue"],
        "why": "the merge queue itself changed: run its own slow group"
      }
    ],
    "review": ".sova/playbook-config/review"
  },
  "release": {
    "playbook": ".sova/playbook-config/release",
    "tag": "v${version}",
    "scheme": "semver",
    "channels": ["stable"],
    "commit": true,
    "checks": [
      {
        "id": "release-notes",
        "label": "Release notes entry",
        "run": ["node", ".sova/playbook-config/release/scripts/sova-release.mjs", "changelog-check"],
        "timeout": 60
      },
      {
        "id": "release-integration",
        "label": "Every integration group",
        "run": ["node", "scripts/nice.mjs", "node", "scripts/run-tests.mjs", "--integration"],
        "timeout": 1800,
        "rerun": true
      },
      {
        "id": "release-extensions",
        "label": "Every extension suite",
        "run": ["node", ".sova/playbook-config/release/scripts/sova-release.mjs", "ext-all"],
        "timeout": 1800
      },
      {
        "id": "release-spec-replay",
        "label": "Spec replay",
        "run": ["node", "scripts/merge-checks/spec-replay.mjs", "--picked"],
        "timeout": 1800
      },
      {
        "id": "release-site",
        "label": "Site build",
        "run": ["node", ".sova/playbook-config/release/scripts/sova-release.mjs", "site-check"],
        "timeout": 900
      },
      {
        "id": "release-spec",
        "label": "No new spec findings",
        "run": ["node", ".sova/playbook-config/release/scripts/sova-release.mjs", "spec-new"],
        "timeout": 600
      },
      {
        "id": "release-leaks",
        "label": "Leak scan since the last release",
        "run": ["node", ".sova/playbook-config/release/scripts/sova-release.mjs", "leak-scan"],
        "timeout": 600
      }
    ]
  }
}
