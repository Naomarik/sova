---
// The Sova mark, inline so it takes currentColor (the accent, where it's used). The legs shade in
// alpha toward the folds; ids are per instance, since a page inlines the mark more than once.
interface Props { size?: number; class?: string }
const { size = 22, class: cls = "" } = Astro.props;
const id = `sova-fold-${Math.random().toString(36).slice(2, 8)}`;
---
<svg class={`mark ${cls}`} viewBox="0 0 32 32" width={size} height={size} aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={`${id}-l`} gradientUnits="userSpaceOnUse" x1="0" y1="6" x2="0" y2="26"><stop offset="0" stop-color="currentColor" stop-opacity=".85" /><stop offset="1" stop-color="currentColor" stop-opacity=".5" /></linearGradient>
    <linearGradient id={`${id}-r`} gradientUnits="userSpaceOnUse" x1="0" y1="6" x2="0" y2="26"><stop offset="0" stop-color="currentColor" stop-opacity=".5" /><stop offset="1" stop-color="currentColor" stop-opacity=".85" /></linearGradient>
  </defs>
  <g transform="translate(0.5 0)">
    <polygon fill={`url(#${id}-l)`} points="2,6 8,6 15,26 9,26" />
    <polygon fill={`url(#${id}-r)`} points="16,6 22,6 29,26 23,26" />
    <polygon fill="currentColor" points="9,26 15,26 22,6 16,6" />
  </g>
</svg>
