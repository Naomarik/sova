{
  "$schema": "sova-theme/v1",
  "name": "Catppuccin Mocha",
  "extends": "dark",
  "vars": {
    "mauve": "#cba6f7",
    "red": "#f38ba8",
    "yellow": "#f9e2af",
    "green": "#a6e3a1",
    "blue": "#89b4fa",
    "text": "#cdd6f4",
    "subtext1": "#bac2de",
    "subtext0": "#a6adc8",
    "overlay1": "#7f849c",
    "surface1": "#45475a",
    "base": "#1e1e2e"
  },
  "colors": {
    "bg": "$base",
    "surface": "#2c2c3e",
    "sunken": "#262637",
    "ink": "$text",
    "ink-2": "$subtext1",
    "ink-muted": "$subtext0",
    "border": "$surface1",
    "border-strong": "$overlay1",
    "accent": "$mauve",
    "accent-hover": "#e1cbfa",
    "accent-tint": "#372252",
    "on-accent": "$base",
    "status-success": "$green",
    "status-warn": "$yellow",
    "status-error": "$red",
    "status-info": "$blue",
    "status-success-bg": "#1f361d",
    "status-warn-bg": "#3a2e15",
    "status-error-bg": "#52202e",
    "status-info-bg": "#1b3153",
    "diff-add-bg": "#1f361d",
    "diff-add-ink": "$green",
    "diff-del-bg": "#52202e",
    "diff-del-ink": "$red",
    "diff-gutter": "#262637",
    "shadow-1": "0 1px 2px rgba(0, 0, 0, .5)",
    "shadow-2": "0 1px 2px rgba(0, 0, 0, .5), 0 8px 24px -12px rgba(0, 0, 0, .75)",
    "shadow-3": "0 2px 4px rgba(0, 0, 0, .6), 0 18px 44px -16px rgba(0, 0, 0, .85)",
    "scrim": "rgba(14, 14, 19, .62)",
    "skeleton-sweep": "rgba(255, 255, 255, .07)"
  }
}
