{
  "$schema": "pi-web-theme/v1",
  "name": "Monokai Machine",
  "extends": "dark",
  "vars": {
    "background": "#273136",
    "text": "#f2fffc",
    "accent3": "#ffed72",
    "accent4": "#a2e57b",
    "accent5": "#7cd5f1",
    "accent6": "#baa0f8",
    "dimmed1": "#b8c4c3",
    "dimmed4": "#545f62"
  },
  "colors": {
    "bg": "$background",
    "surface": "#374146",
    "sunken": "#303a3f",
    "ink": "$text",
    "ink-2": "$dimmed1",
    "ink-muted": "#a3adae",
    "border": "$dimmed4",
    "border-strong": "#828d8f",
    "accent": "$accent6",
    "accent-hover": "#d6c6fb",
    "accent-tint": "#452f78",
    "on-accent": "$background",
    "status-success": "$accent4",
    "status-warn": "$accent3",
    "status-error": "#ff8c99",
    "status-info": "$accent5",
    "status-success-bg": "#2f4821",
    "status-warn-bg": "#484215",
    "status-error-bg": "#78232c",
    "status-info-bg": "#204753",
    "diff-add-bg": "#2f4821",
    "diff-add-ink": "$accent4",
    "diff-del-bg": "#78232c",
    "diff-del-ink": "#ff8c99",
    "diff-gutter": "#303a3f",
    "shadow-1": "0 1px 2px rgba(0, 0, 0, .5)",
    "shadow-2": "0 1px 2px rgba(0, 0, 0, .5), 0 8px 24px -12px rgba(0, 0, 0, .75)",
    "shadow-3": "0 2px 4px rgba(0, 0, 0, .6), 0 18px 44px -16px rgba(0, 0, 0, .85)",
    "scrim": "rgba(14, 14, 19, .62)",
    "skeleton-sweep": "rgba(255, 255, 255, .07)"
  }
}
