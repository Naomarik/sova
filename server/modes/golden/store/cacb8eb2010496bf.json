 {
  "name": "align",
  "description": "@10b18c09da2ac44c",
  "parameters": {
   "type": "object",
   "required": [
    "ops"
   ],
   "properties": {
    "doc": {
     "type": "string",
     "minLength": 1,
     "description": "The alignment to change, e.g. \"al_2\". Required while more than one alignment is open; omit for create, import, exempt and change_request.",
     "pattern": "^al_[1-9][0-9]*$"
    },
    "ops": {
     "type": "array",
     "items": {
      "anyOf": "@8f0d66a627303464"
     },
     "description": "Operations, applied in order. change_request, when given, comes before every other op; create or import comes next (else first) and appears once.",
     "minItems": 1
    }
   },
   "additionalProperties": false
  }
 },
