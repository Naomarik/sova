{
  "name": "sova",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev:server": "node scripts/dev-server.mjs",
    "dev:server:tsx": "tsx watch server/index.ts",
    "dev:server:detached": "PI_WORKER_TRANSPORT=host node scripts/dev-server.mjs",
    "dev:web": "vite",
    "hermetic:agent-dir": "node scripts/hermetic-agent-dir.mjs",
    "dev:hermetic": "node scripts/hermetic-agent-dir.mjs && PORT=4810 PI_CODING_AGENT_DIR=\"$PWD/.agent\" tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test \"server/*.test.ts\" \"src/lib/*.test.ts\""
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.86.1",
    "@hono/node-server": "^1.14.0",
    "highlight.js": "11.12.0",
    "hono": "^4.7.0",
    "markdown-it": "15.0.2",
    "solid-js": "^1.9.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.10",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.11.0"
  }
}
