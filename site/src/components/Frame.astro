---
// A product frame: the app's surfaces in a card, with a sunken strip that names what it shows.
// Every frame is a CSS mock-up, hidden from assistive tech; `caption` says in words what it shows.
import Mark from "./Mark.astro";

interface Props { path: string; caption: string; class?: string; strip?: boolean }
const { path, caption, class: cls = "", strip = true } = Astro.props;
---
<figure class={`frame ${cls}`}>
  <div class="frame-window" aria-hidden="true">
    {strip && (
      <div class="frame-strip">
        <span class="frame-brand"><Mark size={14} />sova</span>
        <span class="frame-path">{path}</span>
      </div>
    )}
    <div class="frame-body"><slot /></div>
  </div>
  <figcaption class="visually-hidden">{caption}</figcaption>
</figure>
