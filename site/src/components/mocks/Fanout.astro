---
// The Fan out dialog, forking the current conversation into 5 members, with the cost preview.
import Frame from "../Frame.astro";
import Icon from "../Icon.astro";
import ContextRing from "../ContextRing.astro";

const members = [
  { model: "anthropic/claude-opus-5-5", fill: "48k of 1M · 5%", pct: 5, n: 2 },
  { model: "zai/glm-5.3", fill: "48k of 200k · 24%", pct: 24, n: 2 },
  { model: "anthropic/claude-sonnet-5", fill: "48k of 200k · 24%", pct: 24, n: 1 },
];
---
<Frame path="demo-app" class="m-frame" caption="The Fan out dialog: fork the current conversation into 5 members across 3 models. Each row shows how full that model's context starts, and the preview says every shared turn is re-sent 5 times.">
  <div class="m-stage">
    <div class="m-modal">
      <div class="m-modal-head">Fan out<Icon name="close" size={16} /></div>
      <div class="m-modal-body">
        <div>
          <div class="m-field-label">Start from</div>
          <div class="m-radio m-radio-on">Fork “Upload client” at its latest message</div>
          <div class="m-radio">A fresh prompt</div>
          <p class="m-hint">Each member gets the whole conversation up to message 12, then goes its own way.</p>
        </div>
        <div>
          <div class="m-field-label">Members</div>
          <div class="m-members">
            {members.map((m) => (
              <div class="m-member">
                <span class="m-member-model">{m.model}</span>
                <span class="m-member-fill"><ContextRing pct={m.pct} />{m.fill}</span>
                <span class="m-count"><i>−</i><b>{m.n}</b><i>+</i></span>
              </div>
            ))}
          </div>
        </div>
        <div class="m-preview">
          <span><strong>5 members × ~48k tokens</strong> re-sent every shared turn.</span>
          <span class="m-muted">Turns start together, so one provider may answer some members with 429. Sova doesn't stagger them.</span>
        </div>
      </div>
      <div class="m-modal-foot">
        <span class="m-btn m-btn-ghost">Cancel</span>
        <span class="m-btn m-btn-primary">Create 5 Members</span>
      </div>
    </div>
  </div>
</Frame>
