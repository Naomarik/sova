{
  "$schema": "sova-theme/v1",
  "name": "Nord Frost",
  "extends": "dark",
  "vars": {
    "nord2": "#434c5e",
    "nord4": "#d8dee9",
    "nord6": "#eceff4",
    "nord7": "#8fbcbb",
    "nord8": "#88c0d0",
    "nord13": "#ebcb8b",
    "nord14": "#a3be8c"
  },
  "colors": {
    "bg": "#21252e",
    "surface": "#2e343f",
    "sunken": "#282e38",
    "ink": "$nord6",
    "ink-2": "$nord4",
    "ink-muted": "#969eac",
    "border": "$nord2",
    "border-strong": "#747d8f",
    "accent": "$nord7",
    "accent-hover": "#a9cbca",
    "accent-tint": "#293434",
    "on-accent": "#21252e",
    "status-success": "$nord14",
    "status-warn": "$nord13",
    "status-error": "#d18d93",
    "status-info": "$nord8",
    "status-success-bg": "#30382a",
    "status-warn-bg": "#41341c",
    "status-error-bg": "#4b2f31",
    "status-info-bg": "#27393f",
    "diff-add-bg": "#30382a",
    "diff-add-ink": "$nord14",
    "diff-del-bg": "#4b2f31",
    "diff-del-ink": "#d18d93",
    "diff-gutter": "#282e38",
    "shadow-1": "0 1px 2px rgba(0, 0, 0, .5)",
    "shadow-2": "0 1px 2px rgba(0, 0, 0, .5), 0 8px 24px -12px rgba(0, 0, 0, .75)",
    "shadow-3": "0 2px 4px rgba(0, 0, 0, .6), 0 18px 44px -16px rgba(0, 0, 0, .85)",
    "scrim": "rgba(14, 14, 19, .62)",
    "skeleton-sweep": "rgba(255, 255, 255, .07)"
  }
}
