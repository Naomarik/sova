# Site-specific settings for scripts/mesh-termux/phone-test.sh. Copy to local.env (untracked, sourced by phone-test.sh)
# and fill in. Addresses below are placeholders (100.64.0.0/10 tailnet).

# the phone: ssh target (Termux sshd), mesh id, label, Tailscale StableID, MagicDNS name
PHONE=100.64.0.3
PHONE_ID=phone
PHONE_LABEL=Phone
PHONE_NODE_ID=nPHONE00000CNTRL
PHONE_DNS=phone.example.ts.net

# the laptop: tailnet IP (install-http serves from it), team server id, Tailscale StableID, peer listener
LAPTOP_IP=100.64.0.4
LAPTOP_ID=laptop
LAPTOP_NODE_ID=nLAPTOP0000CNTRL
LAPTOP_PEER_URL=http://100.64.0.4:4801
