---
// Check in from your phone: the Access page's one-use pairing QR on the desk, and the phone it let
// in, answering the question a session asked.
import Frame from "../Frame.astro";
import Icon from "../Icon.astro";
import ContextRing from "../ContextRing.astro";
import { encodeQr } from "../../../../src/lib/qr";
import { repo } from "../../data/site";

// A real QR, drawn by the app's own encoder. It points at the repository, not at a Sova.
const q = encodeQr(repo);
const size = q.matrix.length + 8;
const path = q.matrix.flatMap((row, y) => row.flatMap((dark, x) => (dark ? [`M${x + 4},${y + 4}h1v1h-1z`] : []))).join("");
---
<figure class="duo duo-pair">
  <Frame path="access" class="m-frame duo-desk" caption="">
    <div class="m-session m-access">
      <header class="m-head"><span class="m-head-title">Access</span></header>
      <div class="m-access-body">
        <div class="m-access-title">Bring a device in</div>
        <p class="m-ink2">The code expires in 5 minutes and works once.</p>
        <svg class="m-qr" viewBox={`0 0 ${size} ${size}`} shape-rendering="crispEdges"><rect width={size} height={size} class="m-qr-bg" /><path d={path} class="m-qr-fg" /></svg>
        <p class="m-muted">Scan with your phone's camera. Keep this QR and its link private.</p>
        <div class="m-mono m-ink2">4:52 left</div>
      </div>
    </div>
  </Frame>
  <div class="phone duo-phone" aria-hidden="true">
    <div class="phone-screen">
      <div class="phone-status"><span>9:42</span><span>84%</span></div>
      <header class="m-head"><span class="m-head-title">Upload metrics</span><span class="m-head-end"><span class="chip chip-warn"><span class="chip-dot"></span>Input</span></span></header>
      <div class="m-thread">
        <div class="m-msg-user">Count failed uploads per hour on the dashboard.</div>
        <p class="m-msg">A retried upload can fail and then succeed. Counting each try would show errors the user never saw.</p>
        <div class="m-ask">
          <div class="m-ask-q">Count a retry as an error, or only the last failed try?</div>
          <div class="m-ask-opts"><span class="m-btn">Every Try</span><span class="m-btn">Last Try Only</span></div>
        </div>
      </div>
      <div class="m-composer">
        <div class="m-composer-row"><span class="m-input">Enter a message</span><span class="m-btn m-btn-primary m-btn-off m-btn-icon"><Icon name="arrow-right" size={14} /></span></div>
        <div class="m-composer-foot"><span class="m-mono">Sonnet 5.5</span><span class="m-end"><ContextRing pct={27} /></span></div>
      </div>
    </div>
  </div>
  <figcaption class="visually-hidden">Sova's Access page on a desktop, showing a one-use pairing QR that expires in 5 minutes. Beside it, the phone that scanned it, in Sova's folded layout: a session asks whether to count a retry as an error, with its 2 answers as buttons.</figcaption>
</figure>
