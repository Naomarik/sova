---
// The Sova mark, inline so it takes currentColor (the accent, where it's used).
interface Props { size?: number; class?: string }
const { size = 22, class: cls = "" } = Astro.props;
---
<svg class={`mark ${cls}`} viewBox="0 0 32 32" width={size} height={size} aria-hidden="true" focusable="false">
  <path fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" d="M4 7L12 25L20 7L28 25M15.6 17H24.4" />
</svg>
