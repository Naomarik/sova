{
  "$schema": "pi-web-theme/v1",
  "name": "Dracula",
  "extends": "dark",
  "vars": {
    "background": "#282a36",
    "current-line": "#44475a",
    "foreground": "#f8f8f2",
    "cyan": "#8be9fd",
    "green": "#50fa7b",
    "purple": "#bd93f9",
    "yellow": "#f1fa8c"
  },
  "colors": {
    "bg": "$background",
    "surface": "#363848",
    "sunken": "#303241",
    "ink": "$foreground",
    "ink-2": "#b5bccf",
    "ink-muted": "#99a3c1",
    "border": "$current-line",
    "border-strong": "#7583af",
    "accent": "$purple",
    "accent-hover": "#d5bafb",
    "accent-tint": "#45296d",
    "on-accent": "$background",
    "status-success": "$green",
    "status-warn": "$yellow",
    "status-error": "#ff8383",
    "status-info": "$cyan",
    "status-success-bg": "#164522",
    "status-warn-bg": "#3b3e15",
    "status-error-bg": "#702020",
    "status-info-bg": "#17414b",
    "diff-add-bg": "#164522",
    "diff-add-ink": "$green",
    "diff-del-bg": "#702020",
    "diff-del-ink": "#ff8383",
    "diff-gutter": "#303241",
    "shadow-1": "0 1px 2px rgba(0, 0, 0, .5)",
    "shadow-2": "0 1px 2px rgba(0, 0, 0, .5), 0 8px 24px -12px rgba(0, 0, 0, .75)",
    "shadow-3": "0 2px 4px rgba(0, 0, 0, .6), 0 18px 44px -16px rgba(0, 0, 0, .85)",
    "scrim": "rgba(14, 14, 19, .62)",
    "skeleton-sweep": "rgba(255, 255, 255, .07)"
  }
}
