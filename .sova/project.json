{
  "version": 1,
  "slots": {"cap": 15},
  "sources": ["package.json", "mise.toml", "pnpm-lock.yaml", "scripts/hermetic-agent-dir.mjs"],
  "setup": [
    {
      "id": "mise-trust",
      "run": ["mise", "trust"],
      "inputs": ["mise.toml"]
    },
    {
      "id": "node-modules",
      "run": ["node", "scripts/copy-tree.mjs", "${main}/node_modules", "node_modules"],
      "inputs": ["pnpm-lock.yaml", "scripts/copy-tree.mjs"],
      "timeout": 600
    },
    {
      "id": "agent-dir",
      "run": ["node", "scripts/hermetic-agent-dir.mjs"],
      "inputs": ["scripts/hermetic-agent-dir.mjs", "pi-config/settings.json"]
    }
  ],
  "services": {
    "server": {
      "cmd": ["pnpm", "run", "dev:hermetic"],
      "env": {"SOVA_PORT": "${ports.server.http}"},
      "ports": {
        "http": {"base": 4810, "stride": 10}
      },
      "ready": {"http": "http", "path": "/api/health", "timeout": 120},
      "about": "This copy's Sova on http://127.0.0.1:${ports.server.http}/ with its own .agent (sessions, state, settings); GET /api/health gives startedAt and head.",
      "isolation": {
        "method": "ports",
        "why": "Each slot's server runs on its own port with the checkout's own .agent dir; slot 0 is the live sova-runtime.service, which Sova only reads."
      },
      "adopt": {
        "unit": "sova-runtime.service",
        "ports": {"http": 4800}
      }
    }
  },
  "test": {
    "run": ["node", "scripts/run-tests.mjs"],
    "smoke": ["shared/project-contract.test.ts"]
  },
  "share": {"allow": false},
  "merge": {
    "target": "master",
    "push": true,
    "checks": [
      {"id": "typecheck", "label": "Typecheck", "run": ["pnpm", "run", "typecheck"], "timeout": 600},
      {"id": "unit", "label": "Unit tests", "run": ["node", "scripts/nice.mjs", "node", "scripts/run-tests.mjs"], "rerun": true, "timeout": 1500},
      {"id": "integration", "label": "Integration", "run": ["node", "scripts/nice.mjs", "node", "scripts/run-tests.mjs", "--integration", "--landing", "--base", "${merge.base}"], "rerun": true, "timeout": 1800},
      {"id": "extensions", "label": "Changed extensions", "run": ["node", "scripts/merge-checks/ext-suites.mjs"], "timeout": 900},
      {"id": "spec-replay", "label": "Spec replay", "run": ["node", "scripts/merge-checks/spec-replay.mjs"], "timeout": 1800},
      {"id": "statecharts", "label": "Statecharts", "run": ["node", "scripts/merge-checks/statecharts.mjs"], "timeout": 1200},
      {"id": "build", "label": "Build", "run": ["pnpm", "run", "build"], "timeout": 900},
      {"id": "spec", "label": "Spec check", "run": ["node", "scripts/merge-checks/spec.mjs"], "timeout": 300},
      {"id": "leak-scan", "label": "Leak scan", "run": ["node", "scripts/merge-checks/leak-scan.mjs"], "timeout": 300}
    ],
    "install": {"run": ["pnpm", "install", "--frozen-lockfile", "--offline"], "inputs": ["pnpm-lock.yaml", "pnpm-workspace.yaml", "package.json"], "timeout": 600},
    "review": ".sova/playbooks/review"
  }
}
