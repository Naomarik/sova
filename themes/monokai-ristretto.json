{
  "$schema": "sova-theme/v1",
  "name": "Monokai Ristretto",
  "extends": "dark",
  "vars": {
    "background": "#2c2525",
    "text": "#fff1f3",
    "accent3": "#f9cc6c",
    "accent4": "#adda78",
    "accent5": "#85dacc",
    "accent6": "#a8a9eb",
    "dimmed1": "#c3b7b8",
    "dimmed4": "#5b5353"
  },
  "colors": {
    "bg": "$background",
    "surface": "#3b3434",
    "sunken": "#352e2e",
    "ink": "$text",
    "ink-2": "$dimmed1",
    "ink-muted": "#a59d9d",
    "border": "$dimmed4",
    "border-strong": "#877d7e",
    "accent": "$accent6",
    "accent-hover": "#c9caf3",
    "accent-tint": "#2f2f5a",
    "on-accent": "$background",
    "status-success": "$accent4",
    "status-warn": "$accent3",
    "status-error": "#fd778f",
    "status-info": "$accent5",
    "status-success-bg": "#2e3c1f",
    "status-warn-bg": "#453616",
    "status-error-bg": "#661f2b",
    "status-info-bg": "#213c38",
    "diff-add-bg": "#2e3c1f",
    "diff-add-ink": "$accent4",
    "diff-del-bg": "#661f2b",
    "diff-del-ink": "#fd778f",
    "diff-gutter": "#352e2e",
    "shadow-1": "0 1px 2px rgba(0, 0, 0, .5)",
    "shadow-2": "0 1px 2px rgba(0, 0, 0, .5), 0 8px 24px -12px rgba(0, 0, 0, .75)",
    "shadow-3": "0 2px 4px rgba(0, 0, 0, .6), 0 18px 44px -16px rgba(0, 0, 0, .85)",
    "scrim": "rgba(14, 14, 19, .62)",
    "skeleton-sweep": "rgba(255, 255, 255, .07)"
  }
}
