# Site-specific settings for scripts/mesh-vps/*.sh. Copy to local.env (untracked, sourced by config.sh) and fill in.
# Addresses below are placeholders (100.64.0.0/10 tailnet, 203.0.113.0/24 documentation range).

# the VPS: ssh target over the tailnet, public IP (the exposure probe), tailnet IP (the peer listener binds it)
VPS_SSH=user@100.64.0.2
VPS_PUBLIC_IP=203.0.113.10
VPS_TAILNET_IP=100.64.0.2
# this host's mesh id and label (the id is seeded into peers.json once and never rewritten)
VPS_ID=vps
VPS_LABEL=vps

# the laptop's team server, the first peer: id, label, Tailscale StableID, MagicDNS name, peer listener, front-door upstream
LAPTOP_ID=laptop
LAPTOP_LABEL=laptop
LAPTOP_NODE_ID=nLAPTOP0000CNTRL
LAPTOP_DNS=laptop.example.ts.net
LAPTOP_PEER_URL=http://100.64.0.4:4801
LAPTOP_SERVE_URL=http://100.64.0.4:4872

# optional: public ports that must stay OPEN, a control for the exposure probe (e.g. "80 443"; empty = none), and
# systemd units whose state must not change across a deploy/smoke (space-separated; empty = the units check is skipped)
VPS_CONTROL_PORTS=
# optional: the public share front this VPS runs (empty = none | vhost | caddy | funnel | cloudflared); vhost, caddy
# and funnel make public 443 an expected-open control of the exposure probe
SHARE_FRONT=
PROD_UNITS="tailscaled"

# optional: the claude executable on the VPS (empty = `command -v claude` in the VPS user's login shell, then common locations)
CLAUDE_BIN=

# optional: node runs Sova on Node instead of Bun (empty = Bun, the version mise.toml pins)
SOVA_RUNTIME=

# optional: the internet relay (§mesh.vps/internet-relay). VPS_RELAY=off (the default): no accept process is installed and
# its port must time out from the public IP. on: each deploy bundles and installs the accept process (an admin installs its
# unit once, SUDO.md §5), and the exposure probe checks the port from outside. VPS_RELAY_PORT: its public port (empty =
# 4803; 443 only while no share front holds 443). See scripts/mesh-dialout/README.md.
VPS_RELAY_PORT=
VPS_RELAY=off
