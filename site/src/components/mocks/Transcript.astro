---
// One web session mid-turn: Rewind on your message, Regenerate and Fork on a reply, an edit shown as a diff,
// a queued follow-up, and the composer in its Steer state.
import Frame from "../Frame.astro";
import Icon from "../Icon.astro";
import ContextRing from "../ContextRing.astro";
---
<Frame path="demo-app" class="m-frame" caption="A session transcript: your message with Copy, Share and Rewind actions, a reply with Copy, Regenerate and Fork, an edit rendered as a diff, a queued follow-up message, and the composer offering Steer and Stop while the turn runs.">
  <div class="m-session">
    <header class="m-head">
      <span class="m-head-title">Upload client</span>
      <span class="m-head-sub m-mono">demo-app</span>
      <span class="m-head-end m-mono m-muted"><ContextRing pct={24} />48k / 200k · 24%</span>
    </header>
    <div class="m-thread">
      <div class="m-msg-user">Cap the backoff at 30 seconds, and log each retry at debug level.</div>
      <div class="m-actions">
        <span class="m-action"><Icon name="copy" size={13} />Copy</span>
        <span class="m-action"><Icon name="external" size={13} />Share</span>
        <span class="m-action"><Icon name="undo" size={13} />Rewind</span>
      </div>
      <p class="m-msg">The delay doubles from 500 ms, so it needs a ceiling before the 7th try. I'll clamp it where it's computed.</p>
      <div class="m-actions m-actions-start">
        <span class="m-action"><Icon name="copy" size={13} />Copy</span>
        <span class="m-action"><Icon name="refresh" size={13} />Regenerate</span>
        <span class="m-action m-action-hot"><Icon name="branch" size={13} />Fork</span>
      </div>
      <div class="m-tool">
        <div class="m-tool-sum"><Icon name="chevron-down" size={12} /><span class="m-tool-name">edit</span><span class="m-tool-arg">src/upload/retry.ts</span><span class="m-tool-stat"><span class="m-add">+3</span><span class="m-del">−1</span></span></div>
        <div class="diff">
          <div class="diff-hunk">@@ -18,6 +18,8 @@ export async function backoff(n, err)</div>
          <div class="diff-line"><span class="diff-gutter">18</span><span>  if (isClientError(err)) throw err</span></div>
          <div class="diff-line diff-del"><span class="diff-gutter">19</span><span>  const ms = 500 * 2 ** (n - 1)</span></div>
          <div class="diff-line diff-add"><span class="diff-gutter">19</span><span>  const ms = Math.min(500 * 2 ** (n - 1), MAX_DELAY)</span></div>
          <div class="diff-line diff-add"><span class="diff-gutter">20</span><span>  log.debug(`retry $&#123;n&#125; in $&#123;ms&#125;ms`, err)</span></div>
          <div class="diff-line diff-add"><span class="diff-gutter">21</span><span>  </span></div>
          <div class="diff-line"><span class="diff-gutter">22</span><span>  await sleep(ms)</span></div>
        </div>
      </div>
      <div class="m-tool"><div class="m-tool-sum"><span class="live-dot"></span><span class="m-tool-name">bash</span><span class="m-tool-arg">pnpm test upload</span><span class="m-muted">4s</span></div></div>
      <div class="m-queued">
        <div class="m-msg-user">Then open a PR against main.</div>
        <span class="m-queued-state">Queued</span>
      </div>
    </div>
    <div class="m-composer">
      <div class="m-composer-row">
        <span class="m-btn m-btn-ghost m-btn-icon"><Icon name="attach" size={16} /></span>
        <span class="m-input">Steer the current turn…</span>
        <span class="m-btn m-btn-primary">Steer</span>
        <span class="m-btn"><Icon name="stop" size={13} />Stop</span>
      </div>
      <div class="m-composer-foot"><span class="live-dot"></span><span class="m-mono">glm-5.3</span><span>zai · high</span></div>
    </div>
  </div>
</Frame>
