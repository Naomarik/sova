---
// Keep your terminal, check from your phone: the Access page's one-use pairing QR on the desk, and
// the phone it let in, watching a session a terminal has open, live and read-only.
import Frame from "../Frame.astro";
import Icon from "../Icon.astro";
import ContextRing from "../ContextRing.astro";
import { encodeQr } from "../../../../src/lib/qr";
import { repo } from "../../data/site";

// A real QR, drawn by the app's own encoder. It points at the repository, not at a Sova.
const q = encodeQr(repo);
const size = q.matrix.length + 8;
const path = q.matrix.flatMap((row, y) => row.flatMap((dark, x) => (dark ? [`M${x + 4},${y + 4}h1v1h-1z`] : []))).join("");
---
<figure class="duo duo-pair">
  <Frame path="access" class="m-frame duo-desk" caption="">
    <div class="m-session m-access">
      <header class="m-head"><span class="m-head-title">Access</span></header>
      <div class="m-access-body">
        <div class="m-access-title">Bring a device in</div>
        <p class="m-ink2">The code expires in 5 minutes and works once.</p>
        <svg class="m-qr" viewBox={`0 0 ${size} ${size}`} shape-rendering="crispEdges"><rect width={size} height={size} class="m-qr-bg" /><path d={path} class="m-qr-fg" /></svg>
        <p class="m-muted">Scan with your phone's camera. Keep this QR and its link private.</p>
        <div class="m-mono m-ink2">4:52 left</div>
      </div>
    </div>
  </Frame>
  <div class="phone duo-phone" aria-hidden="true">
    <div class="phone-screen">
      <div class="phone-status"><span>9:42</span><span>84%</span></div>
      <header class="m-head"><span class="m-head-title">Flaky upload test</span><span class="m-head-end"><span class="chip chip-static">TUI</span></span></header>
      <div class="m-thread">
        <div class="m-msg-user">upload/client.test.ts fails about 1 run in 10. Find out why.</div>
        <div class="m-tool"><div class="m-tool-sum"><Icon name="chevron-right" size={12} /><span class="m-tool-name">bash</span><span class="m-tool-arg">pnpm test client</span><span class="m-del">2 failed</span></div></div>
        <p class="m-msg">The fake server closes the socket on a timer, and the timer races the second chunk.</p>
        <div class="m-tool"><div class="m-tool-sum"><span class="live-dot"></span><span class="m-tool-name">edit</span><span class="m-tool-arg">client.test.ts</span></div></div>
      </div>
      <div class="m-composer m-composer-off">
        <div class="m-composer-reason"><Icon name="terminal" size={14} />Read only while this session is open in the TUI.</div>
        <div class="m-composer-foot"><span class="m-mono">live</span><span class="m-end"><ContextRing pct={58} tone="warn" /></span></div>
      </div>
    </div>
  </div>
  <figcaption class="visually-hidden">Sova's Access page on a desktop, showing a one-use pairing QR that expires in 5 minutes. Beside it, the phone that scanned it, watching a session a terminal has open: it streams live with a TUI chip, and its composer reads: Read only while this session is open in the TUI.</figcaption>
</figure>
