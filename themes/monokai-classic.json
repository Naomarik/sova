{
  "$schema": "sova-theme/v1",
  "name": "Monokai Classic",
  "extends": "dark",
  "vars": {
    "background": "#272822",
    "text": "#fdfff1",
    "accent3": "#e6db74",
    "accent4": "#a6e22e",
    "accent5": "#66d9ef",
    "dimmed1": "#c0c1b5",
    "dimmed4": "#57584f"
  },
  "colors": {
    "bg": "$background",
    "surface": "#353630",
    "sunken": "#2f302a",
    "ink": "$text",
    "ink-2": "$dimmed1",
    "ink-muted": "#9d9e95",
    "border": "$dimmed4",
    "border-strong": "#7e8075",
    "accent": "#b58bff",
    "accent-hover": "#cfb4ff",
    "accent-tint": "#40256e",
    "on-accent": "$background",
    "status-success": "$accent4",
    "status-warn": "$accent3",
    "status-error": "#fb75a6",
    "status-info": "$accent5",
    "status-success-bg": "#313c19",
    "status-warn-bg": "#3d391b",
    "status-error-bg": "#652039",
    "status-info-bg": "#1a3d44",
    "diff-add-bg": "#313c19",
    "diff-add-ink": "$accent4",
    "diff-del-bg": "#652039",
    "diff-del-ink": "#fb75a6",
    "diff-gutter": "#2f302a",
    "shadow-1": "0 1px 2px rgba(0, 0, 0, .5)",
    "shadow-2": "0 1px 2px rgba(0, 0, 0, .5), 0 8px 24px -12px rgba(0, 0, 0, .75)",
    "shadow-3": "0 2px 4px rgba(0, 0, 0, .6), 0 18px 44px -16px rgba(0, 0, 0, .85)",
    "scrim": "rgba(14, 14, 19, .62)",
    "skeleton-sweep": "rgba(255, 255, 255, .07)"
  }
}
