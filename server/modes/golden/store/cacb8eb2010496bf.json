 {
  "name": "agent_transcript",
  "description": "@847d7c660c98fbec",
  "parameters": {
   "type": "object",
   "required": [
    "id"
   ],
   "properties": {
    "id": {
     "type": "string",
     "minLength": 1
    },
    "full": {
     "type": "boolean"
    },
