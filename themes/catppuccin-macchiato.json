{
  "$schema": "sova-theme/v1",
  "name": "Catppuccin Macchiato",
  "extends": "dark",
  "vars": {
    "mauve": "#c6a0f6",
    "red": "#ed8796",
    "yellow": "#eed49f",
    "green": "#a6da95",
    "blue": "#8aadf4",
    "text": "#cad3f5",
    "subtext1": "#b8c0e0",
    "subtext0": "#a5adcb",
    "overlay1": "#8087a2",
    "surface1": "#494d64",
    "base": "#24273a"
  },
  "colors": {
    "bg": "$base",
    "surface": "#32364a",
    "sunken": "#2c3043",
    "ink": "$text",
    "ink-2": "$subtext1",
    "ink-muted": "$subtext0",
    "border": "$surface1",
    "border-strong": "$overlay1",
    "accent": "$mauve",
    "accent-hover": "#dcc5fa",
    "accent-tint": "#432963",
    "on-accent": "$base",
    "status-success": "$green",
    "status-warn": "$yellow",
    "status-error": "$red",
    "status-info": "$blue",
    "status-success-bg": "#2b3e24",
    "status-warn-bg": "#44381e",
    "status-error-bg": "#5e2830",
    "status-info-bg": "#243861",
    "diff-add-bg": "#2b3e24",
    "diff-add-ink": "$green",
    "diff-del-bg": "#5e2830",
    "diff-del-ink": "$red",
    "diff-gutter": "#2c3043",
    "shadow-1": "0 1px 2px rgba(0, 0, 0, .5)",
    "shadow-2": "0 1px 2px rgba(0, 0, 0, .5), 0 8px 24px -12px rgba(0, 0, 0, .75)",
    "shadow-3": "0 2px 4px rgba(0, 0, 0, .6), 0 18px 44px -16px rgba(0, 0, 0, .85)",
    "scrim": "rgba(14, 14, 19, .62)",
    "skeleton-sweep": "rgba(255, 255, 255, .07)"
  }
}
