{
  "$schema": "sova-theme/v1",
  "name": "Tokyo Night Moon",
  "extends": "dark",
  "vars": {
    "bg": "#222436",
    "terminal-black": "#444a73",
    "fg": "#c8d3f5",
    "dark5": "#737aa2",
    "blue": "#82aaff",
    "cyan": "#86e1fc",
    "green": "#c3e88d",
    "yellow": "#ffc777",
    "red": "#ff757f"
  },
  "colors": {
    "bg": "$bg",
    "surface": "#2e324b",
    "sunken": "#292c42",
    "ink": "$fg",
    "ink-2": "#929ac1",
    "ink-muted": "#959ab8",
    "border": "$terminal-black",
    "border-strong": "$dark5",
    "accent": "$blue",
    "accent-hover": "#abc6ff",
    "accent-tint": "#1e325b",
    "on-accent": "$bg",
    "status-success": "$green",
    "status-warn": "$yellow",
    "status-error": "$red",
    "status-info": "$cyan",
    "status-success-bg": "#2e3b1b",
    "status-warn-bg": "#473215",
    "status-error-bg": "#651d22",
    "status-info-bg": "#163b45",
    "diff-add-bg": "#2e3b1b",
    "diff-add-ink": "$green",
    "diff-del-bg": "#651d22",
    "diff-del-ink": "$red",
    "diff-gutter": "#292c42",
    "shadow-1": "0 1px 2px rgba(0, 0, 0, .5)",
    "shadow-2": "0 1px 2px rgba(0, 0, 0, .5), 0 8px 24px -12px rgba(0, 0, 0, .75)",
    "shadow-3": "0 2px 4px rgba(0, 0, 0, .6), 0 18px 44px -16px rgba(0, 0, 0, .85)",
    "scrim": "rgba(14, 14, 19, .62)",
    "skeleton-sweep": "rgba(255, 255, 255, .07)"
  }
}
