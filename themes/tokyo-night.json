{
  "$schema": "sova-theme/v1",
  "name": "Tokyo Night Storm",
  "extends": "dark",
  "vars": {
    "bg": "#24283b",
    "terminal-black": "#414868",
    "fg": "#c0caf5",
    "fg-dark": "#a9b1d6",
    "blue": "#7aa2f7",
    "cyan": "#7dcfff",
    "green": "#9ece6a",
    "yellow": "#e0af68"
  },
  "colors": {
    "bg": "$bg",
    "surface": "#313650",
    "sunken": "#2b3047",
    "ink": "$fg",
    "ink-2": "$fg-dark",
    "ink-muted": "#9ba0bc",
    "border": "$terminal-black",
    "border-strong": "#7980a6",
    "accent": "$blue",
    "accent-hover": "#a0bdf9",
    "accent-tint": "#23355c",
    "on-accent": "$bg",
    "status-success": "$green",
    "status-warn": "$yellow",
    "status-error": "#f88096",
    "status-info": "$cyan",
    "status-success-bg": "#313e23",
    "status-warn-bg": "#473721",
    "status-error-bg": "#67232f",
    "status-info-bg": "#183e54",
    "diff-add-bg": "#313e23",
    "diff-add-ink": "$green",
    "diff-del-bg": "#67232f",
    "diff-del-ink": "#f88096",
    "diff-gutter": "#2b3047",
    "shadow-1": "0 1px 2px rgba(0, 0, 0, .5)",
    "shadow-2": "0 1px 2px rgba(0, 0, 0, .5), 0 8px 24px -12px rgba(0, 0, 0, .75)",
    "shadow-3": "0 2px 4px rgba(0, 0, 0, .6), 0 18px 44px -16px rgba(0, 0, 0, .85)",
    "scrim": "rgba(14, 14, 19, .62)",
    "skeleton-sweep": "rgba(255, 255, 255, .07)"
  }
}
