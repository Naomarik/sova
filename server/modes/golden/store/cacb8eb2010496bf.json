 {
  "name": "agent_kill",
  "description": "Stop one subagent, one run, or all live subagents. Waits for child termination.",
  "parameters": {
   "type": "object",
   "properties": {
    "id": {
     "type": "string",
     "minLength": 1
    },
    "group": {
     "type": "string",
