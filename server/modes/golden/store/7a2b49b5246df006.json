 {
  "type": "object",
  "required": [
   "op"
  ],
  "properties": {
   "op": {
    "type": "string",
    "const": "add"
   },
   "findings": {
    "type": "array",
    "items": {
     "type": "string",
     "minLength": 1
    },
    "description": "Facts you established that shape the plan; each becomes fN."
   },
   "approach": {
    "type": "array",
    "items": {
     "type": "string",
     "minLength": 1
    },
    "description": "The plan's steps, in order; each becomes aN."
   },
   "rejected": {
    "type": "array",
    "items": {
     "type": "object",
     "required": [
      "option",
      "why"
     ],
     "properties": {
      "option": {
       "type": "string",
       "minLength": 1,
       "description": "The alternative you considered."
      },
      "why": {
       "type": "string",
       "minLength": 1,
       "description": "Why not."
      }
     },
     "additionalProperties": false
    },
    "description": "Alternatives you ruled out; each becomes xN."
   },
   "technical": {
    "type": "array",
    "items": {
     "type": "string",
     "minLength": 1
    },
    "description": "Technical notes: the files, code and technical detail the other fields leave out (the writing style says when); each becomes tN."
   },
   "questions": {
    "type": "array",
    "items": {
     "type": "object",
     "required": [
      "topic",
      "ask",
      "recommendation"
     ],
     "properties": "@6fc2cb5e184007cd",
     "additionalProperties": false
    },
    "description": "Decisions the user must make; each becomes qN."
   }
  },
  "additionalProperties": false,
  "description": "Append items to the alignment; they get the next free ids. Give at least one list.",
  "minProperties": 2
 },
 {
