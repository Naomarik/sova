{
  "$schema": "pi-web-theme/v1",
  "name": "Catppuccin Latte",
  "extends": "light",
  "vars": {
    "mauve": "#8839ef",
    "red": "#d20f39",
    "text": "#4c4f69",
    "subtext1": "#5c5f77",
    "overlay2": "#7c7f93",
    "base": "#eff1f5",
    "crust": "#dce0e8"
  },
  "colors": {
    "bg": "$base",
    "surface": "#fdfefe",
    "sunken": "#e5e8ee",
    "ink": "$text",
    "ink-2": "$subtext1",
    "ink-muted": "#6a6d82",
    "border": "$crust",
    "border-strong": "$overlay2",
    "accent": "$mauve",
    "accent-hover": "#7113ec",
    "accent-tint": "#f7f3fc",
    "on-accent": "#fdfefe",
    "status-success": "#307820",
    "status-warn": "#976014",
    "status-error": "$red",
    "status-info": "#0f5cf4",
    "status-success-bg": "#e5f1e3",
    "status-warn-bg": "#f4ede3",
    "status-error-bg": "#f8ebed",
    "status-info-bg": "#e8eef8",
    "diff-add-bg": "#e5f1e3",
    "diff-add-ink": "#307820",
    "diff-del-bg": "#f8ebed",
    "diff-del-ink": "$red",
    "diff-gutter": "#e5e8ee",
    "shadow-1": "0 1px 2px rgba(23, 23, 28, .06)",
    "shadow-2": "0 1px 2px rgba(23, 23, 28, .06), 0 8px 24px -12px rgba(23, 23, 28, .18)",
    "shadow-3": "0 2px 4px rgba(23, 23, 28, .08), 0 18px 44px -16px rgba(23, 23, 28, .26)",
    "scrim": "rgba(14, 14, 19, .55)",
    "skeleton-sweep": "rgba(255, 255, 255, .45)"
  }
}
