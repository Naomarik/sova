# Local-only material: it stays on disk and isn't published.
# Trackable: README.md, USAGE.md, manifest.json, claims/ and tools/.

# Pilot evidence: session metrics, provenance and planning runs with local paths.
/pilot/
# Review packets hold verbatim copies of their inputs, source included.
/reviews/
# Receipts of the retired assessment tool: none is made any more; any left on disk stay unpublished.
/assessments/
# Drafts are working proposals; base/ and evidence/ snapshot source bytes.
/drafts/

# Claims are Markdown, and (format version 2) each claim file's records in the *.json beside it.
# The root *secret*/*credential* rules would hide claims about secrets, so claims/ is
# default-deny: descend every directory, admit only *.md and their *.json records, then
# re-ignore the root's directory rules. Any other support file belongs outside claims/.
/claims/**
!/claims/**/
!/claims/**/*.md
!/claims/**/*.json
/claims/**/node_modules/
/claims/**/dist/
/claims/**/tmp/
/claims/**/.agent/
