{
  "$schema": "pi-web-theme/v1",
  "name": "Nord Light",
  "extends": "light",
  "vars": {
    "nord0": "#2e3440",
    "nord1": "#3b4252",
    "nord3": "#4c566a",
    "nord4": "#d8dee9",
    "nord6": "#eceff4"
  },
  "colors": {
    "bg": "$nord6",
    "surface": "#fbfbfd",
    "sunken": "#e1e6ee",
    "ink": "$nord0",
    "ink-2": "$nord1",
    "ink-muted": "$nord3",
    "border": "$nord4",
    "border-strong": "#7d8696",
    "accent": "#4d6d95",
    "accent-hover": "#3f597a",
    "accent-tint": "#eff2f5",
    "on-accent": "#fbfbfd",
    "status-success": "#577140",
    "status-warn": "#886318",
    "status-error": "#b04751",
    "status-info": "#476b90",
    "status-success-bg": "#e9ede6",
    "status-warn-bg": "#f1ebde",
    "status-error-bg": "#f2e9ea",
    "status-info-bg": "#e8ecef",
    "diff-add-bg": "#e9ede6",
    "diff-add-ink": "#577140",
    "diff-del-bg": "#f2e9ea",
    "diff-del-ink": "#b04751",
    "diff-gutter": "#e1e6ee",
