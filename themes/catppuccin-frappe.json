{
  "$schema": "pi-web-theme/v1",
  "name": "Catppuccin Frappé",
  "extends": "dark",
  "vars": {
    "yellow": "#e5c890",
    "green": "#a6d189",
    "text": "#c6d0f5",
    "subtext1": "#b5bfe2",
    "surface1": "#51576d",
    "base": "#303446"
  },
  "colors": {
    "bg": "$base",
    "surface": "#404457",
    "sunken": "#383c4f",
    "ink": "$text",
    "ink-2": "$subtext1",
    "ink-muted": "#acb3d2",
    "border": "$surface1",
    "border-strong": "#8991ab",
    "accent": "#cca2e7",
    "accent-hover": "#dec2ef",
    "accent-tint": "#543866",
    "on-accent": "$base",
    "status-success": "$green",
    "status-warn": "$yellow",
    "status-error": "#eea4a6",
    "status-info": "#99b4f0",
    "status-success-bg": "#3a4b2e",
    "status-warn-bg": "#534529",
    "status-error-bg": "#723335",
    "status-info-bg": "#314574",
    "diff-add-bg": "#3a4b2e",
    "diff-add-ink": "$green",
    "diff-del-bg": "#723335",
    "diff-del-ink": "#eea4a6",
    "diff-gutter": "#383c4f",
    "shadow-1": "0 1px 2px rgba(0, 0, 0, .5)",
    "shadow-2": "0 1px 2px rgba(0, 0, 0, .5), 0 8px 24px -12px rgba(0, 0, 0, .75)",
    "shadow-3": "0 2px 4px rgba(0, 0, 0, .6), 0 18px 44px -16px rgba(0, 0, 0, .85)",
    "scrim": "rgba(14, 14, 19, .62)",
    "skeleton-sweep": "rgba(255, 255, 255, .07)"
  }
}
