---
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import Icon from "../components/Icon.astro";
import Mark from "../components/Mark.astro";
import InstallBlock from "../components/InstallBlock.astro";
import Baton from "../components/mocks/Baton.astro";
import * as site from "../data/site";

const orgCards = [
  {
    icon: "file", title: "Decisions with provenance",
    body: "Each decision keeps who said it, when, and in their words. A contradiction goes to the person who decides that area.",
    limit: "No model writes the spec. You promote settled decisions, only when you choose.",
  },
  {
    icon: "eye", title: "A project overseer",
    body: "One session per project that spots who hasn't been asked, and acts at the level you grant, up to starting coding sessions.",
    limit: "Starts at gather. Its limits are enforced by the tools, not the prompt.",
  },
  {
    icon: "chat", title: "A page for the owner",
    body: "One link where the client's owner reads how each project is going, in everyday words.",
    limit: "Read only. Never shows goals, profiles, code, models or costs.",
  },
  {
    icon: "folder", title: "The whole organization is one repo",
    body: "Roster, projects, conversations and decisions live in a plain git repo you can move to another Sova host.",
    limit: "Links don't travel, so you send new ones.",
  },
];
---
<Base
  title="Sova · Organizations"
  description="Organizations in Sova: ask the people who know through their own link, one at a time, and keep every decision with who made it and in their words. A preview feature of the open-source Sova workspace."
>
  <SiteNav page="orgs" />

  <main id="main">
    <section class="section" id="orgs" aria-labelledby="orgs-title">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">Organizations <span class="chip chip-accent">Preview</span></span>
          <h1 class="h-section h-page" id="orgs-title">Ask the people who know. Keep what they decide.</h1>
          <p class="lead">An organization is a client or a team you work with: its people, its projects, and one git repo that holds all of it.</p>
        </div>

        <article class="feature">
          <div class="feature-copy">
            <span class="eyebrow">Baton sessions</span>
            <h2 class="h-feature">One conversation, handed from person to person.</h2>
            <div class="prose">
              <p>Start a conversation with a goal only you can see. When the person holding the baton doesn't know, the model hands it to someone on the roster with a question, and Sova makes them a link.</p>
              <p>They see the conversation and nothing else, and decisions are recorded in their own words.</p>
            </div>
            <p class="limit"><Icon name="info" size={18} /><span>People who can't reach your machine need a public address you set up: <a href={site.publicLinksDoc}>public links</a>. Sova's own page never goes public.</span></p>
          </div>
          <div class="feature-visual"><Baton /></div>
        </article>

        <ul class="perks perks-four cards-follow">
          {orgCards.map((c) => (
            <li class="perk">
              <h3><Icon name={c.icon} size={18} />{c.title}</h3>
              <p set:html={c.body} />
              <p class="perk-limit" set:html={c.limit} />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section closing" aria-labelledby="closing-title">
      <div class="wrap">
        <div class="section-head">
          <h2 class="h-section" id="closing-title">Start with the sessions you already have.</h2>
          <p class="lead">Organizations live in the same Sova as your coding sessions.</p>
        </div>
        <div class="closing-install">
          <InstallBlock id="install-orgs" />
          <p class="hero-note">Then run <code>sova</code>, then <code>sova open</code>.</p>
          <a class="button button-ghost" href="/">← Back to Sova</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap">
      <div class="footer-grid">
        <a class="brand" href="/"><Mark size={20} />sova</a>
        <nav class="footer-links" aria-label="Footer">
          <a href={site.repo}>Sova on GitHub</a>
          <a href={site.gettingStarted}>Getting Started</a>
          <a href={site.publicLinksDoc}>Public Links</a>
          <a href={site.license}>License</a>
          <a href={site.pi}>pi</a>
        </nav>
      </div>
      <div class="footer-meta">
        <p>pi is a separate project; Sova is not affiliated with it. Sova is Apache-2.0; <code>pi-config/</code> is licensed separately.</p>
        <p>The screens on this page are mock-ups built from Sova's own styles.</p>
      </div>
    </div>
  </footer>
</Base>
