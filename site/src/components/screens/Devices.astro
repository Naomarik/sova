---
// Hero: one Delegate session in three frames, captured from Sova on the screens story's demo data.
// The desktop workspace (sidebar, chat, the session detail pane on its workers), an unfolded
// foldable held landscape (sidebar left, chat right: Sova's two panes from 768px) and the folded
// cover screen (the chat alone). When a session video is recorded, it plays over the desktop
// still (muted, looping, no script); with reduced motion its source never matches and the still
// shows. data/screens.ts offers the video only when its shape is the still's, so it fills the
// same screen area exactly: never cropped, never letterboxed.
import { getImage } from "astro:assets";
import Frame from "../Frame.astro";
import Screen from "../Screen.astro";
import { video } from "../../data/screens";

const poster = video ? await getImage({ src: video.posterShot.image, format: "webp", width: 1600 }) : null;
---
<div class="devices">
  <figure class="dev dev-desk">
    <Frame strip={false} class="m-frame" caption="" decorative={false}>
      <div class="screen-stack">
        <Screen at="hero.desk" sizes="(min-width: 1120px) 1040px, 920px" eager />
        {video && poster && (
          <video class="screen-video" autoplay muted loop playsinline preload="metadata" poster={poster.src} width={video.width} height={video.height} aria-label={video.alt}>
            <source media="(prefers-reduced-motion: no-preference)" type="video/mp4" src={video.file} />
          </video>
        )}
      </div>
    </Frame>
    <figcaption class="dev-label">On your desk</figcaption>
  </figure>

  <figure class="dev dev-fold">
    <div class="fold">
      <div class="fold-screen screen-fill">
        <Screen at="hero.fold" sizes="(min-width: 1120px) 424px, (max-width: 468px) 84vw, 400px" />
      </div>
    </div>
    <figcaption class="dev-label">Unfolded</figcaption>
  </figure>

  <figure class="dev dev-phone">
    <div class="phone hd-phone">
      <div class="phone-screen screen-fill">
        <Screen at="hero.phone" sizes="(min-width: 1120px) 208px, (max-width: 468px) 41vw, 196px" />
      </div>
    </div>
    <figcaption class="dev-label">Folded</figcaption>
  </figure>
</div>
