  "a work chain with cards breaking it": "<div class=\"live-entry\"><div class=\"message-actions-host\"><article class=\"message message-user \" aria-label=\"You\"><div class=\"message-head\"><span class=\"message-author\">You</span></div><div class=\"message-body message-text\">Go</div></article></div></div><div class=\"live-entry\"><div class=\"chain-live\" data-chain=\"1\" data-chain-first=\"\"><button type=\"button\" class=\"button button-ghost chain-fold\" aria-expanded=\"true\" aria-label=\"Collapse 3 work steps\" title=\"Collapse 3 work steps\"><span class=\"icon icon-sm\" style=\"--icon:url(/icons/chevron-down.svg)\" aria-hidden=\"true\"></span><span class=\"chain-fold-label\">Work · 3 steps · 1 running</span><span class=\"chain-fold-action\">Collapse</span></button><details class=\"disclosure\"><summary class=\"disclosure-summary\"><span class=\"icon icon-sm icon-twist\" style=\"--icon:url(/icons/chevron-right.svg)\" aria-hidden=\"true\"></span><span class=\"disclosure-label\">Thinking</span><span class=\"disclosure-preview\">· plan</span></summary><div class=\"disclosure-body thinking-body\">plan</div></details></div><div class=\"chain-live\" data-chain=\"1\"><div class=\"toolcard \"><details class=\"toolcard-details\"><summary class=\"toolcard-summary\"><span class=\"icon icon-sm icon-twist\" style=\"--icon:url(/icons/chevron-right.svg)\" aria-hidden=\"true\"></span><span class=\"icon icon-sm\" style=\"--icon:url(/icons/file.svg)\" aria-hidden=\"true\"></span><span class=\"toolcard-name\">read</span><span class=\"toolcard-arg\" title=\"/c.ts\">/c.ts</span><span class=\"chip chip-success\"><i class=\"chip-dot\"></i>Done</span></summary></details></div></div><div class=\"chain-live\" data-chain=\"1\" data-chain-last=\"\"><div class=\"toolcard \"><details class=\"toolcard-details\"><summary class=\"toolcard-summary\"><span class=\"icon icon-sm icon-twist\" style=\"--icon:url(/icons/chevron-right.svg)\" aria-hidden=\"true\"></span><span class=\"icon icon-sm\"