---
// Mesh: one sidebar over three hosts, filtered and tagged by host, beside the Mesh page's Hosts
// and Sync cards, and New Session's Host field. One host runs another version, so it shows the
// same-build rule as it is: that host can't be picked.
import Frame from "../Frame.astro";
import Icon from "../Icon.astro";
import ContextRing from "../ContextRing.astro";

const hosts = [
  { name: "laptop", meta: "Sova", chip: "This host", tone: "" },
  { name: "server", meta: "Sova", chip: "Up", tone: "chip-success" },
  { name: "phone", meta: "Sova", chip: "Other version", tone: "chip-warn", why: "phone runs a different Sova version. Update one of them." },
];
const sync = [
  { name: "Settings", meta: "Synced 2m ago", chip: "On", tone: "chip-success" },
  { name: "Themes", meta: "Synced 2m ago", chip: "On", tone: "chip-success" },
  { name: "Extensions", meta: "Kept separate on each host.", chip: "Off", tone: "" },
  { name: "Logins", meta: "Two logins for one provider.", chip: "1 Conflict", tone: "chip-warn" },
];
---
<figure class="meshmock">
  <div class="meshmock-col">
  <Frame path="sessions" class="m-frame meshmock-side" caption="">
    <div class="m-side">
      <div class="m-side-top">
        <span class="m-btn"><Icon name="plus" size={14} />New Session</span>
        <span class="m-btn m-btn-icon"><Icon name="panel-collapse" size={15} /></span>
      </div>
      <div class="mm-filter"><span class="on">All</span><span>laptop</span><span>server</span><span>phone</span></div>
      <div class="m-side-count"><span>9 sessions · 3 hosts</span><span>Select</span></div>
      <div class="m-group-label">Recent <span class="m-sep">·</span> 4</div>
      <div class="m-row m-row-sel">
        <div class="m-row-main">
          <div class="m-row-title"><span class="live-dot"></span><span>Migrate billing tests</span><span class="m-tag">server</span></div>
          <div class="m-row-sum">Moving fixtures to the new schema</div>
          <div class="m-row-meta"><span>just now · working</span><ContextRing pct={46} /></div>
        </div>
      </div>
      <div class="m-row">
        <div class="m-row-main">
          <div class="m-row-title"><span>Retry policy · sonnet-5-5</span><span class="m-tag">laptop</span></div>
          <div class="m-row-sum">Asks: ky's retry, or its own loop?</div>
          <div class="m-row-meta"><span>4m ago · needs input</span><ContextRing pct={22} /></div>
        </div>
      </div>
      <div class="m-row">
        <div class="m-row-main">
          <div class="m-row-title"><span>Nightly dependency bump</span><span class="m-tag">server</span></div>
          <div class="m-row-sum">12 packages updated; tests pass</div>
          <div class="m-row-meta"><span>1h ago · done</span><ContextRing pct={35} /></div>
        </div>
      </div>
      <div class="m-row">
        <div class="m-row-main">
          <div class="m-row-title"><span>Receipt scanner copy</span><span class="m-tag">laptop</span></div>
          <div class="m-row-sum">Shorter error messages for the camera</div>
          <div class="m-row-meta"><span>3h ago · done</span><ContextRing pct={12} /></div>
        </div>
      </div>
    </div>
  </Frame>
  <div class="m-modal mm-new" aria-hidden="true">
    <div class="m-modal-head">New Session<Icon name="close" size={16} /></div>
    <div class="m-modal-body">
      <div>
        <div class="m-field-label">Host</div>
        <div class="mm-select">
          <span class="mm-opt">laptop <span class="m-muted">(this host)</span></span>
          <span class="mm-opt mm-opt-on">server<Icon name="check" size={13} /></span>
          <span class="mm-opt mm-opt-off">phone · other version</span>
        </div>
        <p class="m-hint">The agent runs on server, and the conversation is stored there.</p>
      </div>
    </div>
  </div>
  </div>
  <Frame path="mesh" class="m-frame meshmock-page" caption="">
    <div class="mm-page">
      <section class="mm-card">
        <header class="mm-card-head"><span>Hosts</span><span class="m-btn mm-btn-sm"><Icon name="info" size={12} />Mesh Details</span></header>
        {hosts.map((h) => (
          <div class="mm-host">
            <Icon name="terminal" size={14} class="m-muted" />
            <div class="mm-host-main">
              <p class="mm-host-name">{h.name}</p>
              <p class="mm-host-meta">{h.meta}</p>
              {h.why && <p class="mm-host-why">{h.why}</p>}
            </div>
            <span class={`chip ${h.tone}`}>{h.tone && <span class="chip-dot"></span>}{h.chip}</span>
          </div>
        ))}
      </section>
      <section class="mm-card">
        <header class="mm-card-head"><span>Sync</span><span class="m-btn m-btn-ghost mm-btn-sm">Change What Syncs</span></header>
        {sync.map((s) => (
          <div class="mm-host">
            <div class="mm-host-main">
              <p class="mm-host-name">{s.name}</p>
              <p class="mm-host-meta">{s.meta}</p>
            </div>
            <span class={`chip ${s.tone}`}>{s.tone && <span class="chip-dot"></span>}{s.chip}</span>
          </div>
        ))}
      </section>
    </div>
  </Frame>
  <figcaption class="visually-hidden">Sova's sidebar with sessions from 3 hosts, filterable by host (all, laptop, server, phone), each session tagged with the host it runs on, one of them working on the server, and the New Session dialog's Host field with server picked and phone unavailable. Beside it, the Mesh page: 3 hosts, where laptop is this host, server is up, and phone runs another Sova version and must be updated; and the Sync card, with settings and themes synced, extensions kept separate, and one login conflict to settle.</figcaption>
</figure>
