# Site-specific values for scripts/mesh-dialout/mac-e2e.mjs. Copy to local.env (untracked) and fill in.
# Addresses are placeholders from the documentation ranges.

# the macOS host: ssh target on the LAN and the key that logs in (BatchMode, nothing else from ~/.ssh/config)
MAC_SSH=user@192.0.2.20
MAC_SSH_KEY=$HOME/.ssh/id_ed25519
# a scratch checkout under the Mac user's home (wiped and re-cloned on every run; never the live install)
MAC_DIR=sova-dialout-scratch
# the scratch Sova's main listener on the Mac (loopback only; reached through ssh)
MAC_PORT=4870

# this host as the relay: the address the Mac reaches it at, and the relay port (open it in the firewall
# for the Mac's address only, see scripts/mesh-dialout/README.md)
RELAY_IP=192.0.2.10
RELAY_PORT=4803
# the hermetic relay server's own main listener on this host (loopback)
RELAY_UI_PORT=4871
