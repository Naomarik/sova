  "a stopped reply and an errored one, in a held chat": "<div class=\"live-entry\"><div class=\"message-actions-host\"><article class=\"message message-user \" aria-label=\"You\"><div class=\"message-head\"><span class=\"message-author\">You</span></div><div class=\"message-body message-text\">Go</div></article></div></div><div class=\"live-entry\"><div class=\"\"><article class=\"message \" aria-label=\"claude-x\"><div class=\"message-head\"><span class=\"message-author text-mono\" title=\"anthropic/claude-x\">claude-x</span></div><div class=\"message-body md\"></div></article></div><div class=\"info-row\" role=\"note\"><span class=\"info-row-text\"><span class=\"icon icon-sm\" style=\"--icon:url(/icons/info.svg)\" aria-hidden=\"true\"></span><span>Stopped by you at <code>Feb 1 10:00 AM</code>.</span></span></div></div><div class=\"live-entry\"><div class=\"message-actions-host\"><article class=\"message message-user \" aria-label=\"You\"><div class=\"message-head\"><span class=\"message-author\">You</span></div><div class=\"message-body message-text\">Again</div></article></div></div><div class=\"live-entry\"><div class=\"banner banner-error\" role=\"alert\"><span class=\"icon banner-icon\" style=\"--icon:url(/icons/alert-circle.svg)\" aria-hidden=\"true\"></span><div class=\"banner-main\"><p class=\"banner-title\">The turn stopped with an error.</p><p class=\"banner-body\">429 rate limited. Your messages are kept. Send again to retry.</p></div></div><div class=\"banner banner-info\" role=\"status\"><span class=\"icon banner-icon\" style=\"--icon:url(/icons/info.svg)\" aria-hidden=\"true\"></span><div class=\"banner-main\"><p class=\"banner-title\">This chat's subagents spend anthropic, which is at its usage limit.</p><p class=\"banner-body\">A switch is this chat's own, for later subagent work only: running workers and this chat's own model stay as they are.</p></div><div class=\"banner-action\"><button type=\"button\" class=\"button button-sm\">Manage Subagent Profiles</button></div></div></div>",
  "an errored reply outside a held chat": "<div class=\"live-entry\"><div class=\"message-actions-host\"><article class=\"message message-user \" aria-label=\"You\"><div class=\"message-head\"><span class=\"message-author\">You</span></div><div class=\"message-body message-text\">Go</div></article></div></div><div class=\"live-entry\"><div class=\"\"><article class=\"message \" aria-label=\"claude-x\"><div class=\"message-head\"><span class=\"message-author text-mono\" title=\"anthropic/claude-x\">claude-x</span></div><div class=\"message-body md\"></div></article></div><div class=\"banner banner-error\" role=\"alert\"><span class=\"icon banner-icon\" style=\"--icon:url(/icons/alert-circle.svg)\" aria-hidden=\"true\"></span><div class=\"banner-main\"><p class=\"banner-title\">The turn stopped with an error.</p><p class=\"banner-body\">boom. Your messages are kept. Send again to retry.</p></div></div></div>",
