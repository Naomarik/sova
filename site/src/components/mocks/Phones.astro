---
// Two phones: the folded session list, and a notification on the lock screen.
import Icon from "../Icon.astro";
import Mark from "../Mark.astro";
import ContextRing from "../ContextRing.astro";
---
<figure class="phones">
  <div class="phone phone-lock" aria-hidden="true">
    <div class="phone-screen">
      <div class="phone-status"><span>Sat</span><span>84%</span></div>
      <div class="phone-time">9:41</div>
      <div class="phone-date">Saturday, September 26</div>
      <div class="notif">
        <span class="notif-icon"><Mark size={16} /></span>
        <div>
          <div class="notif-top"><span>Sova</span><span>now</span></div>
          <div class="notif-title">Needs input · Retry policy · claude-sonnet-5</div>
          <div class="notif-body">Use ky's built-in retry, or write the loop by hand?</div>
        </div>
      </div>
      <div class="notif">
        <span class="notif-icon"><Mark size={16} /></span>
        <div>
          <div class="notif-top"><span>Sova</span><span>6m ago</span></div>
          <div class="notif-title">Error · Flaky upload test</div>
          <div class="notif-body">The last turn stopped with an error.</div>
        </div>
      </div>
    </div>
  </div>
  <div class="phone" aria-hidden="true">
    <div class="phone-screen">
      <div class="phone-status"><span>9:42</span><span>84%</span></div>
      <header class="m-head"><span class="m-head-title">Retry policy · sonnet-5</span><span class="m-head-end"><span class="chip chip-warn"><span class="chip-dot"></span>Input</span></span></header>
      <div class="m-thread">
        <div class="m-msg-user">Add retry with backoff to the upload client. Keep its public API as it is.</div>
        <p class="m-msg">The client already depends on <code>ky</code>, which has its own retry option.</p>
        <div class="m-ask">
          <div class="m-ask-q">Use ky's built-in retry, or write the loop by hand?</div>
          <div class="m-ask-opts"><span class="m-btn">Use ky's Retry</span><span class="m-btn">Write the Loop</span></div>
        </div>
      </div>
      <div class="m-composer">
        <div class="m-composer-row"><span class="m-input">Enter a message</span><span class="m-btn m-btn-primary m-btn-off m-btn-icon"><Icon name="arrow-right" size={14} /></span></div>
        <div class="m-composer-foot"><span class="m-mono">claude-sonnet-5</span><span class="m-end"><ContextRing pct={22} /></span></div>
      </div>
    </div>
  </div>
  <figcaption class="visually-hidden">Two phones. One shows a lock screen with 2 Sova notifications: a session needs input, and another stopped with an error. The other shows that session open in Sova's folded layout, with the question and its 2 answers.</figcaption>
</figure>
