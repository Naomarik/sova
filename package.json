{
  "name": "sova",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "auth:token": "node scripts/sova-token.mjs",
    "dev:server": "node scripts/dev-server.mjs",
    "dev:server:tsx": "tsx watch server/index.ts",
    "dev:server:detached": "PI_WORKER_TRANSPORT=host node scripts/dev-server.mjs",
    "dev:web": "vite",
    "hermetic:agent-dir": "node scripts/hermetic-agent-dir.mjs",
    "e2e:settings-footer-save": "node scripts/e2e/settings-footer-save.mjs",
    "e2e:jump-settle": "node scripts/e2e/jump-settle.mjs",
    "e2e:transcript-drift": "node scripts/e2e/transcript-drift.mjs",
    "e2e:transcript-follow": "node scripts/e2e/transcript-follow.mjs",
    "dev:hermetic": "node scripts/hermetic-agent-dir.mjs --unlock-url && PORT=${SOVA_PORT:-4810} PI_CODING_AGENT_DIR=\"$PWD/.agent\" scripts/start-server.sh",
    "dev:hermetic:node": "SOVA_RUNTIME=node pnpm run dev:hermetic",
    "prices:update": "tsx scripts/prices-update.mjs",
    "claude:catalog": "node scripts/claude-catalog.mjs",
    "voice:install": "tsx scripts/voice.ts",
    "statecharts": "tsx scripts/statecharts.ts",
    "statecharts:watch": "node scripts/statecharts-watch.mjs",
    "statecharts:test": "node scripts/statecharts-test.mjs",
    "typecheck": "node scripts/nice.mjs tsc --noEmit",
    "build": "node scripts/nice.mjs tsc --noEmit && node scripts/nice.mjs vite build && node scripts/nice.mjs vite build --mode share",
    "start": "scripts/start-server.sh",
    "test:bun": "node scripts/nice.mjs node scripts/run-tests.mjs --runtime bun",
    "test:node": "node scripts/nice.mjs node scripts/run-tests.mjs --runtime node",
    "test": "node scripts/nice.mjs node scripts/run-tests.mjs",
    "test:int": "node scripts/nice.mjs node scripts/run-tests.mjs --integration",
    "test:all": "node scripts/nice.mjs node scripts/run-tests.mjs --all"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.0.3",
    "@hono/node-server": "^1.14.0",
    "highlight.js": "11.12.0",
    "hono": "^4.7.0",
    "markdown-it": "15.0.2",
    "solid-js": "^1.9.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.10",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.11.0"
  }
}
