{
  "$schema": "pi-web-theme/v1",
  "name": "Tokyo Night Day",
  "extends": "light",
  "vars": {
    "bg": "#e1e2e7",
    "bg-highlight": "#c4c8da",
    "fg": "#3760bf"
  },
  "colors": {
    "bg": "$bg",
    "surface": "#eeeef1",
    "sunken": "#d5d9e4",
    "ink": "$fg",
    "ink-2": "#4f609e",
    "ink-muted": "#5b6288",
    "border": "$bg-highlight",
    "border-strong": "#767ea7",
    "accent": "#1561ca",
    "accent-hover": "#114fa5",
    "accent-tint": "#dbe6f6",
    "on-accent": "#eeeef1",
    "status-success": "#506b34",
    "status-warn": "#7a5e36",
    "status-error": "#b03535",
    "status-info": "#056a7b",
    "status-success-bg": "#dbe1d3",
    "status-warn-bg": "#e4ded6",
    "status-error-bg": "#ecdbdb",
    "status-info-bg": "#c2e5eb",
    "diff-add-bg": "#dbe1d3",
    "diff-add-ink": "#506b34",
    "diff-del-bg": "#ecdbdb",
    "diff-del-ink": "#b03535",
    "diff-gutter": "#d5d9e4",
    "shadow-1": "0 1px 2px rgba(23, 23, 28, .06)",
    "shadow-2": "0 1px 2px rgba(23, 23, 28, .06), 0 8px 24px -12px rgba(23, 23, 28, .18)",
    "shadow-3": "0 2px 4px rgba(23, 23, 28, .08), 0 18px 44px -16px rgba(23, 23, 28, .26)",
    "scrim": "rgba(14, 14, 19, .55)",
    "skeleton-sweep": "rgba(255, 255, 255, .45)"
  }
}
