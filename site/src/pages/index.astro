---
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import Icon from "../components/Icon.astro";
import Mark from "../components/Mark.astro";
import InstallBlock from "../components/InstallBlock.astro";
import ThemeGrid from "../components/ThemeGrid.astro";
import Devices from "../components/screens/Devices.astro";
import ScreenFrame from "../components/screens/ScreenFrame.astro";
import Overseer from "../components/screens/Overseer.astro";
import Phones from "../components/screens/Phones.astro";
import { themes } from "../data/themes";
import { video } from "../data/screens";
import * as site from "../data/site";

const cards = [
  {
    icon: "undo", title: "Rewind, regenerate, fork, steer",
    body: "Rewind to before any message you sent, regenerate or fork from a reply, steer a running turn without stopping it, or switch models mid-session. The context you built stays.",
    limit: `<a class="perk-link" href="/docs/change-direction/">Changing direction, in the docs</a>`,
  },
  {
    icon: "terminal", title: "Claude logins, with failover",
    body: "Use Claude Code's models in chat and in workers, across several logins. A session or worker that hits a usage limit moves on to the next one.",
    limit: "Needs the <code>claude</code> CLI installed and logged in.",
  },
  {
    icon: "shield", title: "A sandbox per session",
    body: "On runs a session's <code>bash</code> in an OS sandbox and checks file tools against the same policy. The default keeps a worker in a worktree writing only there.",
    limit: "It contains an agent's mistakes, not hostile code, and it hasn't been audited.",
  },
  {
    icon: "file", title: "Playbooks and schedules",
    body: "Markdown recipes an agent runs against a project, picked from the composer or run on a schedule. Sova ships 5.",
    limit: "A schedule fires only after you approve it.",
  },
  {
    icon: "external", title: "Share a session",
    body: "A read-only link to a session or part of it, as a snapshot or live. You see who opened each one.",
    limit: `Needs an address you set up (<a href="${site.publicLinksDoc}">how</a>). Recipients need no account.`,
  },
];

const beyond = [
  {
    icon: "network", title: "Mesh: all your machines, one sidebar", href: "/mesh", more: "About Mesh",
    body: "Run Sova on several machines on your tailnet and use them all from one page.",
    limit: "Needs Tailscale, and the same Sova build on every host.",
  },
  {
    icon: "chat", title: "Organizations: ask the people who know", href: "/orgs", more: "About Organizations",
    body: "Hand one conversation from person to person, each through their own link, and keep every decision with who made it.",
    limit: "People outside your tailnet need a listener behind your own HTTPS proxy.",
  },
];
---
<Base
  title="Sova · Every agent session, one calm workspace"
  description="Sova is an open-source browser workspace for the pi coding agent, on your desk or on a phone, foldables included. Delegate work to subagents you can follow, agree on the plan before they build, and read every change as steps."
>
  <SiteNav page="home" />

  <main id="main">
    <!-- HERO -->
    <section class="hero" id="top">
      <div class="wrap">
        <div class="hero-copy">
          <a class="hero-pill" href={site.releaseUrl}>
            <span class="hero-pill-tag">{site.releaseLabel}</span>
            <span><span class="hero-pill-extra">Open source · </span>Apache-2.0<span class="hero-pill-extra"> · For the pi coding agent</span></span>
            <Icon name="arrow-right" size={14} />
          </a>
          <h1 class="h-hero"><span>Every agent session, <span class="grad">one calm workspace.</span></span> <span class="quiet">On your desk, or folded in your pocket.</span></h1>
          <p class="lead">A browser workspace for the <a href={site.pi}>pi</a> coding agent. Hand work to subagents you can follow, and read every change as steps before it lands.</p>
          <div class="hero-actions">
            <InstallBlock id="install-hero" />
            <p class="hero-note">Then run <code>sova</code>, and <code>sova open</code>. Needs Git and Node.js ≥22.19.</p>
            <p class="hero-links">
              <a href="/docs/install/#what-you-need">Full requirements</a>
              <a href={site.installScript}>Read the install script</a>
              <a href="/docs/">Docs</a>
            </p>
          </div>
        </div>
        <div class="hero-stage"><Devices /></div>
      </div>
      <div class="hero-band">
        <div class="wrap">
          <dl class="facts">
            <div class="fact"><dt class="fact-label">Your sessions, read in place</dt><dd class="fact-value">~/.pi/agent</dd></div>
            <div class="fact"><dt class="fact-label">Loopback by default</dt><dd class="fact-value">127.0.0.1:4800</dd></div>
            <div class="fact"><dt class="fact-label">One token per install</dt><dd class="fact-value">sova/auth-token</dd></div>
            <div class="fact"><dt class="fact-label">Open source</dt><dd class="fact-value">Apache-2.0</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <!-- FEATURES -->
    <section class="section" id="features" aria-labelledby="features-title">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">What you get</span>
          <h2 class="h-section" id="features-title">More work, less window switching.</h2>
          <p class="lead">For people who already run coding agents. Your pi sessions, logins, and extensions come with you.</p>
        </div>

        <article class="feature">
          <div class="feature-copy">
            <span class="eyebrow"><span class="eyebrow-num">01</span> Delegate</span>
            <h3 class="h-feature">Hand the work to subagents. Follow every one.</h3>
            <div class="prose">
              <p>In Delegate, a session's agent becomes an orchestrator: it sends each kind of work to the model you routed it to. Every worker opens in the side pane with its own transcript.</p>
            </div>
            <p class="limit"><Icon name="info" size={18} /><span><strong>The shipped routes use Claude Code models</strong>, so install the <code>claude</code> CLI or pick your own in Settings → Subagents.</span></p>
            <p class="feature-more"><a href="/docs/modes/delegate/">Delegate docs<Icon name="arrow-right" size={14} /></a></p>
          </div>
          <div class="feature-visual"><ScreenFrame at="feature.delegate" /></div>
        </article>

        <article class="feature feature-flip">
          <div class="feature-copy">
            <span class="eyebrow"><span class="eyebrow-num">02</span> Alignments</span>
            <h3 class="h-feature">Agree on the plan before anything gets built.</h3>
            <div class="prose">
              <p>With align on, the agent works out what to build with you first, and records the approach, the alternatives it rejected, and its open questions, each with a recommendation. Answer with just “1a”.</p>
            </div>
            <p class="feature-more"><a href="/docs/modes/align/">Alignment docs<Icon name="arrow-right" size={14} /></a></p>
          </div>
          <div class="feature-visual"><ScreenFrame at="feature.alignment" /></div>
        </article>

        <article class="feature">
          <div class="feature-copy">
            <span class="eyebrow"><span class="eyebrow-num">03</span> Worktrees and changes</span>
            <h3 class="h-feature">Review every change as steps.</h3>
            <div class="prose">
              <p>Ask what changed and the agent lays it out as numbered steps, each with a line on why, and no hunk left out. A session also keeps track of the git worktrees it works in.</p>
            </div>
            <p class="limit"><Icon name="info" size={18} /><span>The changes viewer only reads, and Sova never removes a worktree on its own.</span></p>
            <p class="feature-more"><a href="/docs/worktrees-and-changes/">Worktrees and changes docs<Icon name="arrow-right" size={14} /></a></p>
          </div>
          <div class="feature-visual"><ScreenFrame at="feature.changes" /></div>
        </article>

        <article class="feature feature-flip">
          <div class="feature-copy">
            <span class="eyebrow"><span class="eyebrow-num">04</span> Needs you</span>
            <h3 class="h-feature">Know which session needs you, even away from the desk.</h3>
            <div class="prose">
              <p>The Needs you list shows every session waiting on you: a question, an error, a failed worker. The Overseer, a session that reads all the others, can tell you what needs you, start sessions, or send them prompts.</p>
            </div>
            <p class="limit"><Icon name="info" size={18} /><span>The list costs no tokens. The Overseer has no shell and edits no files.</span></p>
            <p class="feature-more"><a href="/docs/needs-you/">Needs you docs<Icon name="arrow-right" size={14} /></a><a href="/docs/overseer/">Overseer docs<Icon name="arrow-right" size={14} /></a></p>
          </div>
          <div class="feature-visual"><Overseer /></div>
        </article>

        <article class="feature">
          <div class="feature-copy">
            <span class="eyebrow"><span class="eyebrow-num">05</span> On your phone</span>
            <h3 class="h-feature">Check in from your phone.</h3>
            <div class="prose">
              <p>Pair once by scanning a one-use QR code, then answer a question, steer a turn, or start a session. With notifications on, a session that needs you reaches your lock screen.</p>
            </div>
            <p class="limit"><Icon name="info" size={18} /><span>Sova listens on <code>127.0.0.1</code>. For a phone to reach it, use <code>tailscale serve</code> or your own HTTPS proxy. On iPhone, add Sova to the Home Screen for notifications.</span></p>
            <p class="feature-more"><a href="/docs/phone/">Phone docs<Icon name="arrow-right" size={14} /></a></p>
          </div>
          <div class="feature-visual"><Phones /></div>
        </article>
      </div>
    </section>

    <!-- MORE -->
    <section class="section section-alt" aria-labelledby="more-title">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">And the rest</span>
          <h2 class="h-section" id="more-title">Small things that add up.</h2>
        </div>
        <ul class="perks">
          {cards.map((c) => (
            <li class="perk">
              <h3><Icon name={c.icon} size={18} />{c.title}</h3>
              <p set:html={c.body} />
              <p class="perk-limit" set:html={c.limit} />
            </li>
          ))}
          <li class="perk">
            <h3><Icon name="plus" size={18} />And more</h3>
            <p>Voice input, tools on your SSH or Docker targets, usage and load pages, and model rules.</p>
            <p class="perk-limit"><a class="perk-link" href={site.customization}>More in Customization</a></p>
          </li>
        </ul>
      </div>
    </section>

    <!-- BEYOND ONE MACHINE -->
    <section class="section section-alt section-join" id="beyond" aria-labelledby="beyond-title">
      <div class="wrap split split-late">
        <div class="section-head" style="margin-bottom:0">
          <span class="eyebrow">Beyond one machine <span class="chip chip-accent">Preview</span></span>
          <h2 class="h-section" id="beyond-title">More hosts, more people.</h2>
          <p class="lead">Each needs setup beyond the install.</p>
        </div>
        <ul class="cards cards-two">
          {beyond.map((c) => (
            <li class="fcard fcard-link">
              <span class="fcard-icon"><Icon name={c.icon} size={20} /></span>
              <h3><a href={c.href}>{c.title}</a></h3>
              <p set:html={c.body} />
              <p class="fcard-limit" set:html={c.limit} />
              <span class="fcard-more" aria-hidden="true">{c.more}<Icon name="arrow-right" size={14} /></span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- THEMES -->
    <section class="section" aria-labelledby="themes-title">
      <div class="wrap">
        <div class="split themes-head">
          <div class="section-head" style="margin-bottom:0">
            <span class="eyebrow">Make it yours</span>
            <h2 class="h-section" id="themes-title">{themes.length} themes. Yours is 1 JSON file.</h2>
            <p class="lead">Pick one in Settings → Themes, or save your own in <code>~/.pi/agent/sova/themes/</code>. No rebuild, no restart.</p>
          </div>
          <pre class="code" aria-label="Example theme file"><span class="c">// ~/.pi/agent/sova/themes/desk-lamp.json</span>
&#123;
  <span class="k">"name"</span>: <span class="s">"Desk Lamp"</span>,
  <span class="k">"extends"</span>: <span class="s">"dark"</span>,
  <span class="k">"vars"</span>: &#123; <span class="k">"amber"</span>: <span class="s">"#ffb454"</span> &#125;,
  <span class="k">"colors"</span>: &#123;
    <span class="k">"accent"</span>: <span class="a">"$amber"</span>,
    <span class="k">"accent-tint"</span>: <span class="s">"#3a2f1c"</span>
  &#125;
&#125;</pre>
        </div>
        <ThemeGrid />
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section class="section section-alt" id="how" aria-labelledby="how-title">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">How it works</span>
          <h2 class="h-section" id="how-title">One process that runs pi, on your machine.</h2>
          <p class="lead">A server with the pi coding agent embedded, plus a web app. It uses pi's own agent directory: your sessions, logins, and extensions.</p>
        </div>
        <div class="arch">
          <div class="arch-node">
            <h3><Icon name="chat" size={18} />Your browser</h3>
            <p>The desktop workspace, or the folded layout installed on a phone.</p>
          </div>
          <div class="arch-link"><span>REST + WebSocket</span></div>
          <div class="arch-node arch-node-core">
            <h3><Mark size={18} />sova server</h3>
            <p>Hono and the pi SDK, on <code>127.0.0.1:4800</code> by default.</p>
            <ul class="arch-list"><li>runs pi sessions</li><li>runs workers and the Overseer</li><li>checks the install's token</li></ul>
          </div>
          <div class="arch-link"><span>same files</span></div>
          <div class="arch-node">
            <h3><Icon name="folder" size={18} />~/.pi/agent</h3>
            <p>pi's agent directory. Sova's own state lives in <code>sova/</code>.</p>
            <ul class="arch-list"><li>sessions/*.jsonl</li><li>auth.json</li><li>extensions/</li><li>sova/</li></ul>
          </div>
          <div class="arch-link arch-link-down"><span>same files</span></div>
          <div class="arch-node arch-node-tui">
            <h3><Icon name="terminal" size={18} />pi's terminal UI</h3>
            <p>Optional. A session it has open streams into Sova live, and stays read-only there.</p>
          </div>
          <div class="arch-provider"><Icon name="external" size={16} /><span>Model requests go from Sova to your configured provider. Tools and extensions may use the network too.</span></div>
        </div>

        <!-- WHAT IT TOUCHES -->
        <div class="split touches-block" id="touches">
          <div class="section-head" style="margin-bottom:0">
            <h3 class="h-feature">What it touches.</h3>
            <ul class="not-list" aria-label="What Sova is not">
              <li>Not a hosted service. It runs on your machine.</li>
              <li>Not a team app. One person runs it; others see only what you share.</li>
            </ul>
          </div>
          <dl class="touches">
            <div class="touch"><dt>Install</dt><dd><code>~/.local/share/sova</code> and a <code>~/.local/bin/sova</code> launcher. No <code>sudo</code>, no system packages, no shell-profile edits, no settings.</dd></div>
            <div class="touch"><dt>pi extensions</dt><dd>One link per Sova extension in <code>~/.pi/agent/extensions/</code>. <code>--no-extensions</code> skips this.</dd></div>
            <div class="touch"><dt>Login service</dt><dd>Only if you say yes, or pass <code>--service</code>.</dd></div>
            <div class="touch"><dt>Access</dt><dd>Loopback by default, and <strong>one token per install</strong>. Delete <code>~/.pi/agent/sova/auth-token</code> and restart to sign every browser out.</dd></div>
            <div class="touch"><dt>Off by default</dt><dd>The share listener and Mesh, until you set them up.</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <!-- CLOSING: the install, then the source for anyone who'd rather build it. -->
    <section class="section closing" aria-labelledby="closing-title">
      <div class="wrap">
        <div class="section-head">
          <h2 class="h-section" id="closing-title">Run your next pi session here.</h2>
          <p class="lead">Sessions you already have show up as soon as it starts.</p>
        </div>
        <div class="closing-install">
          <InstallBlock id="install-closing" />
          <p class="hero-note">Then run <code>sova</code>, and <code>sova open</code>.</p>
        </div>

        <!-- OPEN SOURCE -->
        <div class="split oss" id="source">
          <div class="oss-copy">
            <span class="eyebrow">Open source</span>
            <h3 class="h-feature">Apache-2.0, built in the open.</h3>
            <p class="prose">TypeScript end to end: a SolidJS web app and a Hono server with the pi SDK embedded. Read the code, file an issue, or run a checkout.</p>
            <div class="oss-actions">
              <a class="button" href={site.repo}><Icon name="external" size={16} />View on GitHub</a>
              <a class="button button-ghost" href={site.contributing}>Read CONTRIBUTING</a>
            </div>
          </div>
          <pre class="code" aria-label="Run a checkout"><span class="c"># Run a checkout: Git, Node.js ≥22.19, pnpm, and Bun 1.4.2</span>
<span class="k">git clone</span> https://github.com/Naomarik/sova.git
<span class="k">cd</span> sova
<span class="k">pnpm install</span> --frozen-lockfile
<span class="k">pnpm run</span> build
<span class="k">pnpm start</span>   <span class="c"># http://127.0.0.1:4800, on Bun</span>
<span class="k">pnpm start</span> --node   <span class="c"># the same, on Node</span></pre>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap">
      <div class="footer-grid">
        <a class="brand" href="#top"><Mark size={20} />sova</a>
        <nav class="footer-links" aria-label="Footer">
          <a href={site.repo}>Sova on GitHub</a>
          <a href="/docs/">Docs</a>
          <a href={site.gettingStarted}>Getting Started</a>
          <a href={site.customization}>Customization</a>
          <a href="/mesh">Mesh</a>
          <a href="/orgs">Organizations</a>
          <a href={site.license}>License</a>
          <a href={site.pi}>pi</a>
        </nav>
      </div>
      <div class="footer-meta">
        <p>pi is a separate project; Sova is not affiliated with it. Sova is Apache-2.0; <code>pi-config/</code> is licensed separately.</p>
        <p>Fonts: Inter and JetBrains Mono, SIL OFL 1.1. {video ? "The screenshots and the video" : "The screenshots"} on this page are Sova running on demo data, and the model replies in them are scripted. The phone lock screen beside the Overseer is an illustration.</p>
        <p>Checked against <code>{site.verified.ref}</code> at <code>{site.verified.rev}</code> on {site.verified.date}; installs <code>{site.installRef}</code>{site.release ? "" : " until the first release is tagged"}.</p>
      </div>
    </div>
  </footer>
</Base>
