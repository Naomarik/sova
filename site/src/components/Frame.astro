---
// A product frame: the app's surfaces in a card, with a sunken strip that names what it shows.
// Two kinds of content go in it. A real screenshot (Screen.astro, from site/scripts/screens/): the
// frame's chrome is hidden from assistive tech and the image's alt text says what it shows. A CSS
// mock-up (the Mesh and Organizations pages' illustrations): `decorative` (the default) hides the
// whole window, and `caption` says in words what it shows. A frame inside a larger figure leaves
// `caption` empty, and the figure says it instead.
import Mark from "./Mark.astro";

interface Props { path: string; caption: string; class?: string; strip?: boolean; decorative?: boolean }
const { path, caption, class: cls = "", strip = true, decorative = true } = Astro.props;
---
<figure class={`frame ${cls}`}>
  <div class="frame-window" aria-hidden={decorative ? "true" : undefined}>
    {strip && (
      <div class="frame-strip" aria-hidden="true">
        <span class="frame-brand"><Mark size={16} />sova</span>
        <span class="frame-path">{path}</span>
      </div>
    )}
    <div class="frame-body"><slot /></div>
  </div>
  {caption && <figcaption class="visually-hidden">{caption}</figcaption>}
</figure>
