 {
  "name": "team_create",
  "description": "@194e2d571f0d54e0",
  "parameters": {
   "type": "object",
   "required": [
    "name",
    "objective",
    "members"
   ],
   "properties": {
    "name": {
     "type": "string",
     "minLength": 1,
     "maxLength": 64,
     "description": "Unique team name (trimmed, case-insensitive)."
    },
    "objective": {
     "type": "string",
     "minLength": 1,
     "maxLength": 4000
    },
    "defaults": {
     "type": "object",
     "properties": {
      "backend": {
       "type": "string",
       "minLength": 1
      },
      "model": {
       "type": "string"
      },
      "effort": {
       "type": "string",
       "enum": [
        "off",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
       ]
      },
      "backendOptions": {
       "type": "object",
       "patternProperties": {
        "^.*$": {}
       }
      }
     },
     "description": "Applied only to members whose backend equals defaults.backend (default pi); member fields win and backendOptions merge shallowly. team_add reuses them."
    },
    "members": {
     "anyOf": [
      {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "role",
         "prompt"
        ],
        "properties": "@d546d0f06a6c6240"
       },
       "minItems": 1
      },
      {
       "type": "string"
      }
     ],
     "description": "A list of member objects, one per role (no per-request limit; a team seats 24, and a chat runs at most 24 workers). A JSON string of that list is read as the list."
    }
   },
   "additionalProperties": false
  }
 },
