---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Mark from "../components/Mark.astro";
import InstallBlock from "../components/InstallBlock.astro";
import ThemeGrid from "../components/ThemeGrid.astro";
import Workspace from "../components/mocks/Workspace.astro";
import Fanout from "../components/mocks/Fanout.astro";
import Transcript from "../components/mocks/Transcript.astro";
import Watch from "../components/mocks/Watch.astro";
import Workers from "../components/mocks/Workers.astro";
import Alignment from "../components/mocks/Alignment.astro";
import Changes from "../components/mocks/Changes.astro";
import Overseer from "../components/mocks/Overseer.astro";
import Phones from "../components/mocks/Phones.astro";
import Baton from "../components/mocks/Baton.astro";
import Mesh from "../components/mocks/Mesh.astro";
import { themes } from "../data/themes";
import * as site from "../data/site";

const cards = [
  {
    icon: "shield", title: "A sandbox per session",
    body: "Off, Subagents only, or On. On runs a session's <code>bash</code> in an OS sandbox (bubblewrap on Linux, Seatbelt on macOS) and checks every file tool's path against the same policy. Subagents only, the default, keeps a worker in a worktree writing only there.",
    limit: "It contains an agent's mistakes. It isn't a boundary for hostile code, and it hasn't been audited.",
  },
  {
    icon: "file", title: "Playbooks and schedules",
    body: "Markdown recipes an agent runs against a project: an accessibility audit, launch notes. Pick one from the composer, add a line of your own, and send. A project's playbook can also run by itself on a schedule.",
    limit: "Yours live in <code>~/.pi/agent/sova/playbooks/</code>. A schedule fires only after you approve it.",
  },
  {
    icon: "terminal", title: "Claude Code, with failover",
    body: "Chat with Claude Code's models and run workers on the Claude Code CLI. Add more Claude logins in Settings → Accounts, and a session or worker that hits a usage limit moves on to the next one.",
    limit: "Experimental. Needs the <code>claude</code> CLI installed and logged in; Claude Code does every sign-in.",
  },
  {
    icon: "network", title: "Beyond your laptop",
    body: "Run a session's tools on your own SSH, AWS SSM, Docker, or Incus targets. Tools run on the target, not through a local mount.",
    limit: "Needs the <code>remote</code> extension and your targets in <code>~/.pi/agent/targets.json</code>.",
  },
  {
    icon: "sliders", title: "Your model rules",
    body: "Settings → Models decides which models this machine may use, and which may be given to subagents. A disabled model is never silently swapped for another.",
    limit: "Saved in <code>~/.pi/agent/model-policy.json</code>.",
  },
  {
    icon: "gauge", title: "Usage, agents, and load",
    body: "The Usage page shows your subscription and spend windows, and the Agents page what's running. The resource monitor charges CPU and memory to the session and worker that started each process.",
    limit: "Usage meters need the <code>usage-status</code> extension. The monitor only reads.",
  },
  {
    icon: "chat", title: "Voice input",
    body: "A mic in every composer. A local speech model on your Sova host turns the clip into text at the caret, and nothing sends until you do.",
    limit: "Set up once in Settings → Voice: a whisper.cpp build and a 574 MB model. Audio goes only to your Sova host.",
  },
  {
    icon: "external", title: "Share a session",
    body: "Send a read-only link to a whole session or just part of it, as a snapshot or following live, one link per recipient. You see who opened each one.",
    limit: `Needs an address you set up: <a href="${site.publicLinksDoc}">docs/public-links.md</a>. Recipients need no account or tailnet.`,
  },
  {
    icon: "grid", title: "Sova extensions",
    body: "Add a small web app of your own: a card on Sova's landing page, and a page beside the sessions list, served from Sova's origin.",
    limit: "It can call every Sova API. Install only extensions you trust.",
  },
  {
    icon: "refresh", title: "Starts at login",
    body: "The installer can run Sova as a per-user service that starts at login and restarts if it exits: launchd on macOS, a systemd user unit on Linux.",
    limit: "Only if you say yes, or pass <code>--service</code>. No <code>sudo</code>.",
  },
];

const orgCards = [
  {
    icon: "file", title: "Decisions with provenance",
    body: "Each decision keeps who said it, where, when, and in their words. Sova compares the decisions on each topic and sends any contradiction to the person who decides that area. You then promote the settled ones into the project's own spec.",
    limit: "No model writes the spec. Promotion is a fixed writer, a few decisions at a time, and only when you choose.",
  },
  {
    icon: "eye", title: "A project overseer",
    body: "One session per project that watches for new decisions, spots who hasn't been asked, and acts at the level you grant: propose, gather, reconcile, or build. Build starts coding sessions, each in its own worktree.",
    limit: "Starts at gather. Limits per message, per day and at once are enforced by the tools, not the prompt.",
  },
  {
    icon: "chat", title: "A page for the owner",
    body: "Pick the client's owner and send one link. They read how each project is going, in everyday words: updates at real milestones, who was asked, what was decided, what was built.",
    limit: "Read only. Never shows goals, profiles, code, models or costs. The link lasts 90 days.",
  },
  {
    icon: "folder", title: "The whole organization is one repo",
    body: "Roster, projects, conversations, decisions and the overseer's notes live in a plain git repo. Clone it onto another Sova host and attach it.",
    limit: "Links don't travel, so you send new ones. On the new host, overseers start paused.",
  },
];

const meshCards = [
  {
    icon: "refresh", title: "A front door that fails over",
    body: "The Mesh page writes a Caddy config that sends you to the first healthy host in your order, and back when it recovers.",
    limit: "You run it behind <code>tailscale serve</code>, never Funnel. A reply in progress can fail during a switch.",
  },
  {
    icon: "network", title: "Linked sessions",
    body: "Ask the Overseer to link sessions on different hosts, so they can message each other and offer each other files. Their traffic shows in the Agents tab, not the transcript.",
    limit: "One session per host in a link. A file moves only when the other side accepts it.",
  },
  {
    icon: "terminal", title: "A phone as a host",
    body: "Sova can run in Termux on an Android phone, and join the mesh like any other host. Its uninstaller removes exactly what the install added.",
    limit: "Experimental, and it needs setup; a guide is coming. Android with Termux only. Other phones use Sova in the browser.",
  },
];
---
<Base
  title="Sova · Run AI sessions side by side"
  description="Sova is an open-source browser workspace for AI coding sessions. Delegate to subagents you can follow, agree on the plan before they build, run models side by side, and use every machine you own from one page."
>
  <header class="nav">
    <div class="wrap nav-inner">
      <a class="brand" href="#top" aria-label="Sova, back to top"><Mark size={24} />sova</a>
      <nav class="nav-links" aria-label="Page">
        <a href="#features">Features</a>
        <a class="nav-link-extra" href="#orgs">Organizations</a>
        <a class="nav-link-extra" href="#mesh">Mesh</a>
        <a href="#how">How It Works</a>
        <a href="#source">Open Source</a>
      </nav>
      <span class="nav-spacer"></span>
      <a class="button button-ghost nav-gh" href={site.repo}><Icon name="external" size={16} /><span class="nav-gh-label">GitHub</span><span class="visually-hidden"> (Sova on GitHub)</span></a>
      <button type="button" class="button button-ghost button-icon theme-toggle" data-theme-toggle aria-label="Use Light Theme" aria-pressed="false">
        <Icon name="sun" size={18} class="icon-sun" /><Icon name="moon" size={18} class="icon-moon" />
      </button>
    </div>
  </header>

  <main id="main">
    <!-- HERO -->
    <section class="hero" id="top">
      <div class="wrap">
        <div class="hero-copy">
          <Mark tile size={88} class="hero-mark" />
          <a class="hero-pill" href={`${site.repo}/releases/tag/${site.release}`}>
            <span class="hero-pill-tag">{site.release}</span>
            <span>Open source · Apache-2.0<span class="hero-pill-extra"> · For the pi coding agent</span></span>
            <Icon name="arrow-right" size={14} />
          </a>
          <h1 class="h-hero"><span>Run AI sessions <span class="grad">side by side.</span></span> <span class="quiet">Stop juggling terminals.</span></h1>
          <p class="lead">Send one prompt to several models, compare their approaches, and branch the conversation worth pursuing. Sova runs your AI sessions in the browser, from a full desktop workspace to your phone, with the sessions you already have.</p>
          <div class="hero-actions">
            <InstallBlock id="install-hero" />
            <p class="hero-note">Then run <code>sova</code> and open <code>http://127.0.0.1:4800</code>. Needs Git, Node.js ≥22.19, and pnpm (or npx). Sova runs on the <a href={site.pi}>pi</a> coding agent, and the install brings its own copy.</p>
            <div class="hero-links">
              <a class="button button-ghost" href={site.installScript}><Icon name="file" size={16} />Read the Install Script</a>
              <a class="button button-ghost" href={site.gettingStarted}><Icon name="arrow-right" size={16} />Getting Started</a>
              <a class="button button-ghost" href="#orgs"><Icon name="network" size={16} />Organizations and Mesh</a>
            </div>
          </div>
        </div>
        <div class="hero-stage"><Workspace /></div>
      </div>
      <div class="hero-band">
        <div class="wrap">
          <dl class="facts">
            <div class="fact"><dt class="fact-label">Your sessions, read in place</dt><dd class="fact-value">~/.pi/agent</dd></div>
            <div class="fact"><dt class="fact-label">Loopback by default</dt><dd class="fact-value">127.0.0.1:4800</dd></div>
            <div class="fact"><dt class="fact-label">Several machines, one list</dt><dd class="fact-value">Mesh</dd></div>
            <div class="fact"><dt class="fact-label">Read it, fork it</dt><dd class="fact-value">Apache-2.0</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <!-- FEATURES -->
    <section class="section" id="features" aria-labelledby="features-title">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">What you get</span>
          <h2 class="h-section" id="features-title">More work, less window switching.</h2>
          <p class="lead">Sova is for people who already run AI coding sessions. Hand the work to subagents, agree on the plan before they build, and read every change before it lands. Your terminal setup stays yours.</p>
        </div>

        <article class="feature">
          <div class="feature-copy">
            <span class="eyebrow"><span class="eyebrow-num">01</span> Delegate</span>
            <h3 class="h-feature">Hand the work to subagents. Follow every one.</h3>
            <div class="prose">
              <p>Switch a session to Delegate and its agent becomes an orchestrator. It sorts the work into planning, investigation, routine changes, and complex changes, and sends each kind to the model you routed it to, with an optional fallback. A subagent profile keeps those routes and your team defaults under one name, so a usage limit is 1 switch away from another setup.</p>
              <p>Bigger jobs get a team: coordinated workers with one role each. Every worker and team member opens in the side pane with its own transcript and how full its context is.</p>
            </div>
            <p class="limit"><Icon name="info" size={18} /><span>Routes live in Settings → Subagents. <strong>The shipped routes use Claude Code models</strong>, so install the <code>claude</code> CLI or pick your own. Delegate, workers, and teams come from the <a href={site.modeExtension}><code>mode</code></a> and <a href={site.subagentsExtension}><code>subagents</code></a> pi extensions, which the installer links.</span></p>
          </div>
          <div class="feature-visual"><Workers /></div>
        </article>

        <article class="feature feature-flip">
          <div class="feature-copy">
            <span class="eyebrow"><span class="eyebrow-num">02</span> Alignments</span>
            <h3 class="h-feature">Agree on the plan before anything gets built.</h3>
            <div class="prose">
              <p>Turn on align and the agent works out what to build with you first. It records each agreement as an alignment: what it found, the approach, the alternatives it rejected and why, and its open questions, each with a recommendation. Answer in chat, even as just “1a”.</p>
              <p>With adversarial review on, a fresh read-only reviewer checks the plan, and later the finished diff of complex work. What it finds is recorded on the alignment.</p>
            </div>
            <p class="limit"><Icon name="info" size={18} /><span>Adversarial review is experimental and off by default: Settings → Experimental. Align works the same in pi's terminal UI.</span></p>
          </div>
          <div class="feature-visual"><Alignment /></div>
        </article>

        <article class="feature">
          <div class="feature-copy">
            <span class="eyebrow"><span class="eyebrow-num">03</span> Worktrees and changes</span>
            <h3 class="h-feature">Work in worktrees. Read every change before it lands.</h3>
            <div class="prose">
              <p>A session keeps track of the git worktrees it works in. Ask the agent to create, merge, or drop one. Workers start only in the session's folder or one of its worktrees, and each merge lands in the transcript as a card.</p>
              <p>The changes viewer shows what a session or a worktree changed, file by file, as a diff. It only reads: it never writes to your working tree or runs a git command that changes anything.</p>
            </div>
            <p class="limit"><Icon name="info" size={18} /><span>Worktrees come from the <code>worktrees</code> pi extension, which the installer links; <code>--no-extensions</code> skips that.</span></p>
          </div>
          <div class="feature-visual"><Changes /></div>
        </article>

        <article class="feature feature-flip">
          <div class="feature-copy">
            <span class="eyebrow"><span class="eyebrow-num">04</span> The Overseer</span>
            <h3 class="h-feature">One session that keeps an eye on the rest.</h3>
            <div class="prose">
              <p>The Overseer reads every session and tells you which ones need you: an open question, an error, a stuck worker. Ask it to start sessions, send prompts, or tidy up. When a request is ambiguous or risky, it asks first, with a card that lists each session it would touch and why.</p>
              <p>It also keeps your ideas and todos from plain chat, so a passing thought doesn't become a session by accident.</p>
            </div>
            <ul class="points">
              <li><Icon name="check" size={16} /><span><strong>List Only</strong>, the default, shows who needs you in the sidebar and costs no tokens.</span></li>
              <li><Icon name="check" size={16} />No shell and no file edits: it acts through Sova, with limits per turn you can set.</li>
            </ul>
          </div>
          <div class="feature-visual"><Overseer /></div>
        </article>

        <article class="feature">
          <div class="feature-copy">
            <span class="eyebrow"><span class="eyebrow-num">05</span> Several approaches at once</span>
            <h3 class="h-feature">Ask 3 models the same thing. Read the answers side by side.</h3>
            <div class="prose">
              <p>Fan out from the conversation you're in, so every copy branches at the same message, or start several fresh sessions with one prompt. A group opens as split or tabbed panes, with 1 composer that writes to every member.</p>
            </div>
            <p class="limit"><Icon name="info" size={18} /><span>Every shared turn goes to every member, so it costs that many times as much. <strong>Sova says so before you create the group.</strong></span></p>
          </div>
          <div class="feature-visual"><Fanout /></div>
        </article>

        <article class="feature feature-flip">
          <div class="feature-copy">
            <span class="eyebrow"><span class="eyebrow-num">06</span> Change direction</span>
            <h3 class="h-feature">Fork, rewind, steer. Keep the context you built.</h3>
            <div class="prose">
              <p>Fork or rewind from any message, regenerate any reply, steer a running turn, queue the next one, and switch models mid-session. Tool calls read as cards and edits as diffs, so you follow the work without scrollback.</p>
            </div>
          </div>
          <div class="feature-visual"><Transcript /></div>
        </article>

        <article class="feature">
          <div class="feature-copy">
            <span class="eyebrow"><span class="eyebrow-num">07</span> Keep your terminal</span>
            <h3 class="h-feature">Your terminal sessions, live, in a browser tab.</h3>
            <div class="prose">
              <p>Sova lists every session in your agent directory. There's no import step and no copy. A session a terminal has open streams in live, and stays read-only here until the terminal lets it go. Sending, steering, and rewinding happen in web sessions.</p>
            </div>
            <p class="limit"><Icon name="info" size={18} /><span>Knowing which sessions a terminal has open takes the <code>sessions</code> extension, which the installer links for you. Without it, sessions are still listed and readable.</span></p>
          </div>
          <div class="feature-visual"><Watch /></div>
        </article>

        <article class="feature feature-flip">
          <div class="feature-copy">
            <span class="eyebrow"><span class="eyebrow-num">08</span> On your phone</span>
            <h3 class="h-feature">Check on a long run from across the room.</h3>
            <div class="prose">
              <p>The layout folds to one column and installs as an app. Read transcripts, watch terminal sessions, and keep chatting in web sessions.</p>
              <p>When a session needs you, Sova can send a notification to your phone, even with Sova closed: a question, an error, a stuck worker. No model call, no tokens.</p>
            </div>
            <p class="limit"><Icon name="info" size={18} /><span>Sova has no login of its own. Reach it through <strong>an authenticated tunnel or an HTTPS reverse proxy</strong> that protects every route, including <code>/api</code> and <code>/ws</code>. Notifications need that HTTPS address; on iPhone, add Sova to the Home Screen first.</span></p>
          </div>
          <div class="feature-visual"><Phones /></div>
        </article>
      </div>
    </section>

    <!-- ORGANIZATIONS -->
    <section class="section section-alt" id="orgs" aria-labelledby="orgs-title">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">Organizations <span class="chip chip-accent">Preview</span></span>
          <h2 class="h-section" id="orgs-title">Ask the people who know. Keep what they decide.</h2>
          <p class="lead">An organization is a client or a team you work with: its people, its projects, and one git repo that holds all of it. Sova asks each person through their own link, one at a time, and keeps every answer with who gave it and in which words.</p>
        </div>

        <article class="feature">
          <div class="feature-copy">
            <span class="eyebrow">Baton sessions</span>
            <h3 class="h-feature">One conversation, handed from person to person.</h3>
            <div class="prose">
              <p>Start a conversation with a goal only you can see. The model talks to whoever holds the baton. When they don't know, it hands the baton to someone on the roster with a question and a short briefing, and Sova makes that person a link.</p>
              <p>They see the conversation and nothing else: no tool calls, no goal, no other sessions. Every message carries its sender's name.</p>
            </div>
            <ul class="points">
              <li><Icon name="check" size={16} />Decisions are recorded as they're made, with the speaker's own words.</li>
              <li><Icon name="check" size={16} />Profiles learn each person's language and skills from their own words. The page people see never shows a profile.</li>
            </ul>
            <p class="limit"><Icon name="info" size={18} /><span>People outside your tailnet open their link through Sova's share listener, which is off by default and sits behind an HTTPS reverse proxy you run. <strong>It needs setup; a guide is coming.</strong> Each link is shown once.</span></p>
          </div>
          <div class="feature-visual"><Baton /></div>
        </article>

        <ul class="cards cards-fit cards-follow">
          {orgCards.map((c) => (
            <li class="fcard">
              <span class="fcard-icon"><Icon name={c.icon} size={20} /></span>
              <h3>{c.title}</h3>
              <p set:html={c.body} />
              <p class="fcard-limit" set:html={c.limit} />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- MESH -->
    <section class="section" id="mesh" aria-labelledby="mesh-title">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">Mesh <span class="chip chip-accent">Preview · Needs Tailscale</span></span>
          <h2 class="h-section" id="mesh-title">All your machines, one sidebar.</h2>
          <p class="lead">Run Sova on a laptop, a server and an Android phone on your tailnet, and use them all from any one page. A session runs on the host you pick, and you drive it from wherever you are.</p>
        </div>

        <article class="feature feature-flip">
          <div class="feature-copy">
            <span class="eyebrow">Several hosts</span>
            <h3 class="h-feature">Start it on the server. Check it from the couch.</h3>
            <div class="prose">
              <p>Every host's sessions appear in one list, labelled by host and filterable. New Session asks which host. An organization on another host opens there, with its pages and its overseer.</p>
              <p>Settings, themes, extensions and logins can be kept in step, each behind its own switch. With logins on, they're copied to every host. Two different logins for the same provider are shown as a conflict for you to settle, never overwritten.</p>
            </div>
            <p class="limit"><Icon name="info" size={18} /><span>Sova has no login: your tailnet is the gate, and any device that reaches one host can use them all. <strong>Every host in a mesh must be reachable by the same devices, and run the same Sova build.</strong> <a href={site.meshDoc}>docs/mesh.md</a> covers the setup.</span></p>
          </div>
          <div class="feature-visual"><Mesh /></div>
        </article>

        <ul class="cards cards-fit cards-follow">
          {meshCards.map((c) => (
            <li class="fcard">
              <span class="fcard-icon"><Icon name={c.icon} size={20} /></span>
              <h3>{c.title}</h3>
              <p set:html={c.body} />
              <p class="fcard-limit" set:html={c.limit} />
            </li>
          ))}
        </ul>
        <p class="hero-note cards-note">With no peer added, nothing changes: no extra port, no Tailscale calls, no requests to other machines.</p>
      </div>
    </section>

    <!-- MORE -->
    <section class="section section-alt" aria-labelledby="more-title">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">And the rest</span>
          <h2 class="h-section" id="more-title">Small things that add up.</h2>
        </div>
        <ul class="cards">
          {cards.map((c) => (
            <li class="fcard">
              <span class="fcard-icon"><Icon name={c.icon} size={20} /></span>
              <h3>{c.title}</h3>
              <p set:html={c.body} />
              <p class="fcard-limit" set:html={c.limit} />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- THEMES -->
    <section class="section" aria-labelledby="themes-title">
      <div class="wrap">
        <div class="split themes-head">
          <div class="section-head" style="margin-bottom:0">
            <span class="eyebrow">Make it yours</span>
            <h2 class="h-section" id="themes-title">{themes.length} themes. Yours is 1 JSON file.</h2>
            <p class="lead">Pick a built-in theme in Settings → Themes, or save your own in <code>~/.pi/agent/sova/themes/</code>. While the Themes tab is open, the picker picks it up within 2 seconds. No rebuild, no restart.</p>
          </div>
          <pre class="code" aria-label="Example theme file"><span class="c">// ~/.pi/agent/sova/themes/desk-lamp.json</span>
&#123;
  <span class="k">"name"</span>: <span class="s">"Desk Lamp"</span>,
  <span class="k">"extends"</span>: <span class="s">"dark"</span>,
  <span class="k">"vars"</span>: &#123; <span class="k">"amber"</span>: <span class="s">"#ffb454"</span> &#125;,
  <span class="k">"colors"</span>: &#123;
    <span class="k">"accent"</span>: <span class="a">"$amber"</span>,
    <span class="k">"accent-tint"</span>: <span class="s">"#3a2f1c"</span>
  &#125;
&#125;</pre>
        </div>
        <ThemeGrid />
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section class="section section-alt" id="how" aria-labelledby="how-title">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">How it works</span>
          <h2 class="h-section" id="how-title">One process, next to your terminal.</h2>
          <p class="lead">Sova is a Node server with its coding agent embedded, plus a web app. It reads the same agent directory as the agent in your terminal: the same sessions, the same login, the same extensions.</p>
        </div>
        <div class="arch">
          <div class="arch-node">
            <h3><Icon name="chat" size={18} />Your browser</h3>
            <p>The desktop workspace, or the folded layout installed on a phone.</p>
            <ul class="arch-list"><li>sessions and groups</li><li>transcripts and diffs</li><li>settings and themes</li></ul>
          </div>
          <div class="arch-link"><span>REST + WebSocket</span></div>
          <div class="arch-node arch-node-core">
            <h3><Mark size={18} />sova server</h3>
            <p>Hono and the pi SDK, on <code>127.0.0.1:4800</code> by default.</p>
            <ul class="arch-list"><li>hosts web sessions</li><li>watches terminal sessions</li><li>fans out, forks, rewinds</li><li>runs the Overseer</li></ul>
          </div>
          <div class="arch-link"><span>same files</span></div>
          <div class="arch-node">
            <h3><Icon name="folder" size={18} />~/.pi/agent</h3>
            <p>Shared with pi in your terminal. Sova's own state lives in <code>sova/</code>.</p>
            <ul class="arch-list"><li>sessions/*.jsonl</li><li>auth.json</li><li>extensions/</li><li>sova/</li></ul>
          </div>
          <div class="arch-link arch-link-down"><span>same files</span></div>
          <div class="arch-node arch-node-tui">
            <h3><Icon name="terminal" size={18} />pi in your terminal</h3>
            <p>Unchanged. A session it has open streams into Sova live, and stays read-only there.</p>
          </div>
          <div class="arch-provider"><Icon name="external" size={16} /><span>Model requests go from Sova, and from pi in your terminal, to your configured provider. Tools and extensions may use the network too.</span></div>
        </div>
      </div>
    </section>

    <!-- WHAT IT TOUCHES -->
    <section class="section" aria-labelledby="touch-title">
      <div class="wrap split">
        <div class="section-head" style="margin-bottom:0">
          <span class="eyebrow">Before you install</span>
          <h2 class="h-section" id="touch-title">What it touches, and what it doesn't.</h2>
          <p class="lead">Sova shares a directory with a process you trust, so here's the whole list.</p>
          <ul class="not-list" aria-label="What Sova is not">
            <li>Not a hosted service. It runs on your machine.</li>
            <li>Not a team app. One person runs it; the people you ask see only the conversation you share.</li>
            <li>Not a replacement for pi's TUI. It's a second window.</li>
          </ul>
        </div>
        <dl class="touches">
          <div class="touch"><dt>Install</dt><dd><code>~/.local/share/sova</code> and a <code>~/.local/bin/sova</code> launcher. No <code>sudo</code>, no toolchain, no shell-profile edits.</dd></div>
          <div class="touch"><dt>pi extensions</dt><dd>One link per Sova extension in <code>~/.pi/agent/extensions/</code>. Anything already there that isn't its own link is left alone. <code>--no-extensions</code> skips this.</dd></div>
          <div class="touch"><dt>Settings</dt><dd>None of pi's own configuration. It writes <code>~/.pi/agent/sova/settings.json</code> once, to switch on Claude Code models, and only if the file doesn't exist.</dd></div>
          <div class="touch"><dt>Login service</dt><dd>Only if you ask for one.</dd></div>
          <div class="touch"><dt>Your sessions</dt><dd>Read in place. A session open in a terminal is read-only here.</dd></div>
          <div class="touch"><dt>Sova's state</dt><dd>Groups, drafts, archive, and themes, in <code>~/.pi/agent/sova/</code>, and each organization's workspace repo.</dd></div>
          <div class="touch"><dt>Network</dt><dd>Model requests go to your configured provider. Tools and extensions may use the network.</dd></div>
          <div class="touch"><dt>Access</dt><dd>Single user, loopback by default, <strong>no built-in authentication</strong>. Anyone who can reach an unprotected Sova can read files and run commands as you.</dd></div>
          <div class="touch"><dt>Share listener</dt><dd>Off unless you set it. It serves only shared conversations and the owner page; every other path answers 404.</dd></div>
          <div class="touch"><dt>Mesh</dt><dd>Off until you add a peer. Then a second port on your tailnet address only. With login sync on, your provider logins are copied to every host.</dd></div>
          <div class="touch"><dt>Re-running</dt><dd>Installs the same pinned release and changes nothing when it's already there.</dd></div>
        </dl>
      </div>
    </section>

    <!-- OPEN SOURCE -->
    <section class="section section-alt" id="source" aria-labelledby="source-title">
      <div class="wrap split">
        <div class="section-head" style="margin-bottom:0">
          <span class="eyebrow">Open source</span>
          <h2 class="h-section" id="source-title">Apache-2.0, built in the open.</h2>
          <p class="lead">TypeScript end to end: a SolidJS web app, a Hono server with the pi SDK embedded, and the optional pi extensions in <code>pi-config/</code>. Read the code, file an issue, or run a checkout.</p>
          <div class="oss-actions">
            <a class="button button-primary" href={site.repo}><Icon name="external" size={16} />View on GitHub</a>
            <a class="button button-ghost" href={site.contributing}>Read CONTRIBUTING</a>
          </div>
        </div>
        <pre class="code" aria-label="Run a checkout"><span class="c"># Run a checkout: Git, Node.js ≥22.19, pnpm</span>
<span class="k">git clone</span> https://github.com/Naomarik/sova.git
<span class="k">cd</span> sova
<span class="k">pnpm install</span> --frozen-lockfile
<span class="k">pnpm run</span> build
<span class="k">pnpm start</span>   <span class="c"># http://127.0.0.1:4800</span></pre>
      </div>
    </section>

    <!-- CLOSING -->
    <section class="section closing" aria-labelledby="closing-title">
      <div class="wrap">
        <div class="section-head">
          <h2 class="h-section" id="closing-title">Try it on the sessions you already have.</h2>
          <p class="lead">Existing sessions are readable as soon as it starts. To chat, it uses the provider login you already have, or you log in once from the bundled CLI.</p>
        </div>
        <div class="closing-install">
          <InstallBlock id="install-closing" />
          <p class="hero-note">Then run <code>sova</code> and open <code>http://127.0.0.1:4800</code>. Keep it running while you use the app; <code>Ctrl+C</code> stops it.</p>
        </div>
      </div>
    </section>
